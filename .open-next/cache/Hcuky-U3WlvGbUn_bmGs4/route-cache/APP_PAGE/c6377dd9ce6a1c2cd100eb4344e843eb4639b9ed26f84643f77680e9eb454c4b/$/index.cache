l,{\"className\":\"font-display text-3xl font-semibold tracking-tight\",\"children\":\"A premium partner for credibility and digital performance\"}],[\"$\",\"ul\",null,{\"className\":\"mt-6 space-y-4 text-sm leading-6 text-white/75\",\"children\":[[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-white\",\"children\":\"Client-focused strategy.\"}],\" Services are aligned with your goals, audience, and practical constraints.\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-white\",\"children\":\"Responsible consulting.\"}],\" We communicate clearly, especially for policy-sensitive services such as Wikipedia consulting.\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-white\",\"children\":\"Modern execution.\"}],\" We combine design, SEO, technology, and conversion thinking into cohesive solutions.\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-white\",\"children\":\"Global mindset.\"}],\" Serving clients across the United States and worldwide with a professional digital-first approach.\"]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"rounded-3xl border border-border bg-white p-6 shadow-sm md:p-8\",\"children\":[[\"$\",\"p\",null,{\"className\":\"mb-3 text-xs font-semibold uppercase tracking-[0.22em] text-electric\",\"children\":\"Free Consultation\"}],[\"$\",\"h2\",null,{\"className\":\"font-display text-3xl font-semibold tracking-tight text-navy md:text-4xl \",\"children\":\"Request a quote or consultation\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted\",\"children\":\"Share your goals and we’ll help identify the right service path.\"}],[\"$\",\"div\",null,{\"className\":\"mt-6\",\"children\":[\"$\",\"$L37\",null,{\"compact\":true}]}]]}]]}]}]\n26:[\"$\",\"section\",null,{\"id\":\"$undefined\",\"className\":\"section-pad \",\"children\":[\"$\",\"div\",null,{\"className\":\"container-tight grid gap-10 lg:grid-cols-[.9fr_1.1fr]\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"p\",null,{\"className\":\"mb-3 text-xs font-semibold uppercase tracking-[0.22em] text-electric\",\"children\":\"FAQ\"}],[\"$\",\"h2\",null,{\"className\":\"font-display text-3xl font-semibold tracking-tight text-navy md:text-4xl \",\"children\":\"Common questions about Wikipedia consulting, AEO & GEO\"}],[\"$\",\"p\",null,{\"className\":\"mt-4 text-muted\",\"children\":\"Direct answers to common questions about our Wikipedia services and modern search visibility approach.\"}]]}],[\"$\",\"$L38\",null,{\"items\":[{\"q\":\"What Wikipedia services does MIQ Enterprises provide?\",\"a\":\"MIQ Enterprises LLC provides Wikipedia consulting services including Wikipedia notability assessment, citation and reliable source research, Wikipedia article writing guidance, neutral draft planning, Wikipedia editing support, Articles for Creation (AfC) process guidance, conflict-of-interest disclosure guidance, and Wikipedia page maintenance recommendations.\"},{\"q\":\"What are AEO and GEO?\",\"a\":\"AEO (Answer Engine Optimization) structures content so answer engines can extract clear, direct responses. GEO (Generative Engine Optimization) improves entity clarity, topical authority, and trustworthy signals so generative AI systems can understand and cite content accurately. MIQ Enterprises applies both alongside strong SEO fundamentals.\"},{\"q\":\"Does MIQ Enterprises guarantee Wikipedia publication or #1 rankings?\",\"a\":\"No. MIQ Enterprises LLC does not guarantee Wikipedia publication, approval, retention, rankings, or AI citations. Wikipedia decisions are made by independent editors, and search/AI systems control their own results. We focus on ethical, research-driven, best-practice guidance.\"}]}]]}]}]\n27:[\"$\",\"section\",null,{\"id\":\"$undefined\",\"className\":\"section-pad bg-navy text-white\",\"children\":[\"$\",\"div\",null,{\"className\":\"container-tight grid gap-8 lg:grid-cols-[1fr_1fr] lg:items-center\"