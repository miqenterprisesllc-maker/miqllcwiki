ame\":\"rounded-3xl border border-border bg-white p-6 shadow-sm md:p-8\",\"children\":[[\"$\",\"p\",null,{\"className\":\"mb-3 text-xs font-semibold uppercase tracking-[0.22em] text-electric\",\"children\":\"Free Consultation\"}],[\"$\",\"h2\",null,{\"className\":\"font-display text-3xl font-semibold tracking-tight text-navy md:text-4xl \",\"children\":\"Request a quote or consultation\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-muted\",\"children\":\"Share your goals and we’ll help identify the right service path.\"}],[\"$\",\"div\",null,{\"className\":\"mt-6\",\"children\":[\"$\",\"$L36\",null,{\"compact\":true}]}]]}]]}]}]\na:[\"$\",\"section\",null,{\"className\":\"section-pad \",\"children\":[\"$\",\"div\",null,{\"className\":\"container-tight grid gap-10 lg:grid-cols-[.9fr_1.1fr]\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"p\",null,{\"className\":\"mb-3 text-xs font-semibold uppercase tracking-[0.22em] text-electric\",\"children\":\"FAQ\"}],[\"$\",\"h2\",null,{\"className\":\"font-display text-3xl font-semibold tracking-tight text-navy md:text-4xl \",\"children\":\"Common questions about Wikipedia consulting, AEO & GEO\"}],[\"$\",\"p\",null,{\"className\":\"mt-4 text-muted\",\"children\":\"Direct answers to common questions about our Wikipedia services and modern search visibility approach.\"}]]}],[\"$\",\"$L37\",null,{\"items\":[{\"q\":\"What Wikipedia services does MIQ Enterprises provide?\",\"a\":\"MIQ Enterprises LLC provides Wikipedia consulting services including Wikipedia notability assessment, citation and reliable source research, Wikipedia article writing guidance, neutral draft planning, Wikipedia editing support, Articles for Creation (AfC) process guidance, conflict-of-interest disclosure guidance, and Wikipedia page maintenance recommendations.\"},{\"q\":\"What are AEO and GEO?\",\"a\":\"AEO (Answer Engine Optimization) structures content so answer engines can extract clear, direct responses. GEO (Generative Engine Optimization) improves entity clarity, topical authority, and trustworthy signals so generative AI systems can understand and cite content accurately. MIQ Enterprises applies both alongside strong SEO fundamentals.\"},{\"q\":\"Does MIQ Enterprises guarantee Wikipedia publication or #1 rankings?\",\"a\":\"No. MIQ Enterprises LLC does not guarantee Wikipedia publication, approval, retention, rankings, or AI citations. Wikipedia decisions are made by independent editors, and search/AI systems control their own results. We focus on ethical, research-driven, best-practice guidance.\"}]}]]}]}]\nb:[\"$\",\"section\",null,{\"className\":\"section-pad bg-navy text-white\",\"children\":[\"$\",\"div\",null,{\"className\":\"container-tight grid gap-8 lg:grid-cols-[1fr_1fr] lg:items-center\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"p\",null,{\"className\":\"mb-3 text-xs font-semibold uppercase tracking-[0.22em] text-electric\",\"children\":[\"$\",\"span\",null,{\"className\":\"text-gold\",\"children\":\"Insights\"}]}],[\"$\",\"h2\",null,{\"className\":\"font-display text-3xl font-semibold\",\"children\":\"Subscribe for practical digital insights\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-white/72\",\"children\":\"Receive updates when MIQ Enterprises publishes resources on Wikipedia consulting, AEO, GEO, visibility, and technology.\"}]]}],[\"$\",\"div\",null,{\"children\":[\"$\",\"$L38\",null,{}]}]]}]}]\nc:[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/0yh8ebqj3uiaj.js\",\"async\":true}]\nd:[\"$\",\"$L39\",null,{\"children\":[\"$\",\"$16\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@3a\"}]}]\n18:[\"$\",\"meta\",\"24\",{\"property\":\"og:image:alt\",\"content\":\"MIQ LLC — Worldwide Wikipedia Consulting, Editorial Guidance & Digital Services\"}]\n19:[\"$\",\"meta\",\"25\",{\"property\":\"og:type\",\"content\":\"website\"}]\n1a:[\"$\",\"meta\",\"26\",{\"name\":\"twitter:card\",\"content\":\"summary_large_image\"}]\n1b:[\"$\",\"meta\",\"27\",{