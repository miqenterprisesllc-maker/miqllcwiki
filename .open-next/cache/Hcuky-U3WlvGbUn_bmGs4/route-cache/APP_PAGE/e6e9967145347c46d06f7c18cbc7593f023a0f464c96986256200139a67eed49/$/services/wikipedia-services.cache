, professional online presence.\"}],[\"$\",\"span\",null,{\"className\":\"mt-4 inline-flex items-center gap-1 text-sm font-semibold text-electric\",\"children\":[\"Explore \",[\"$\",\"$L2a\",null,{\"icon\":\"$24:props:children:props:children:2:props:children:0:props:children:2:props:children:1:props:icon\",\"className\":\"transition group-hover:translate-x-0.5\",\"size\":16}]]}]]}]]}]]}]}]\n25:[\"$\",\"$L32\",\"28\",{}]\n33:I[65254,[\"$27\",\"$28\"],\"ContactForm\"]\n2b:[\"$\",\"$L2a\",null,{\"icon\":\"$20:props:children:props:children:0:props:children:3:props:children:0:props:children:0:props:icon\",\"className\":\"mt-0.5 shrink-0 text-electric\",\"size\":18}]\n2c:[\"$\",\"span\",null,{\"children\":\"Company, Brand & Biography Wikipedia Page Guidance\"}]\n2d:[\"$\",\"div\",null,{\"className\":\"mt-6 rounded-2xl border border-gold/30 bg-gold/10 p-5 text-sm leading-6 text-charcoal\",\"children\":[[\"$\",\"strong\",null,{\"children\":\"Important:\"}],\" Wikipedia consulting, Wikipedia page creation guidance, and Wikipedia editing services must follow independent editorial policies, notability guidelines, reliable sourcing requirements, and paid-contribution disclosure rules. MIQ Enterprises LLC does not guarantee publication or retention.\"]}]\n2e:[\"$\",\"div\",null,{\"className\":\"rounded-3xl border border-border bg-white p-6 shadow-sm\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-display text-xl font-semibold text-navy\",\"children\":\"Start a Service Inquiry\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-sm text-muted\",\"children\":\"Tell us about your goals and we’ll respond with next steps.\"}],[\"$\",\"div\",null,{\"className\":\"mt-5\",\"children\":[\"$\",\"$L33\",null,{\"service\":\"Worldwide Wikipedia Services & Consulting\",\"compact\":true}]}]]}]\n2f:[\"$\",\"$L2a\",null,{\"icon\":\"$20:props:children:props:children:0:props:children:3:props:children:0:props:children:0:props:icon\",\"className\":\"mt-1 shrink-0 text-electric\",\"size\":18}]\n