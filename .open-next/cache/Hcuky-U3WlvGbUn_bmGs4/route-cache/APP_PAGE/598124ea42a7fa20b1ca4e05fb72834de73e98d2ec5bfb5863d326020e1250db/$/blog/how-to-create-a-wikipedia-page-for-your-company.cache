\\":[[[\\\"$\\\",\\\"section\\\",\\\"check-eligibility\\\",{\\\"id\\\":\\\"check-eligibility\\\",\\\"className\\\":\\\"mb-10 scroll-mt-28\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"font-display text-2xl font-semibold text-navy md:text-3xl\\\",\\\"children\\\":\\\"Start with eligibility, not writing\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mt-4 space-y-4 text-base leading-8 text-muted\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",\\\"Wikipedia is an encyclopedia, not a marketing channel. Before creating a company article, the most important step is determining whether the company has received significant coverage in reliable, independent secondary sources. Company websites, press releases, paid placements, social profiles, and routine directory listings usually do not establish eligibility on their own.\\\",{\\\"children\\\":\\\"Wikipedia is an encyclopedia, not a marketing channel. Before creating a company article, the most important step is determining whether the company has received significant coverage in reliable, independent secondary sources. Company websites, press releases, paid placements, social profiles, and routine directory listings usually do not establish eligibility on their own.\\\"}],[\\\"$\\\",\\\"p\\\",\\\"A practical first step is to collect independent coverage from reputable publications, books, or other editorially controlled sources. The coverage should be about the company itself, not merely a passing mention in a broader story. If strong independent coverage is limited, it may be better to focus on building verifiable public coverage before pursuing an article.\\\",{\\\"children\\\":\\\"A practical first step is to collect independent coverage from reputable publications, books, or other editorially controlled sources. The coverage should be about the company itself, not merely a passing mention in a broader story. If strong independent coverage is limited, it may be better to focus on building verifiable public coverage before pursuing an article.\\\"}]]}]]}],[\\\"$\\\",\\\"section\\\",\\\"sources\\\",{\\\"id\\\":\\\"sources\\\",\\\"className\\\":\\\"mb-10 scroll-mt-28\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"font-display text-2xl font-semibold text-navy md:text-3xl\\\",\\\"children\\\":\\\"Gather reliable, independent sources\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mt-4 space-y-4 text-base leading-8 text-muted\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",\\\"Reliable sources are central to every Wikipedia article. For companies, useful sources often include reputable news organizations, industry publications, books, and other independent outlets with editorial oversight. Each important statement in a draft should be supported by an appropriate source.\\\",{\\\"children\\\":\\\"Reliable sources are central to every Wikipedia article. For companies, useful sources often include reputable news organizations, industry publications, books, and other independent outlets with editorial oversight. Each important statement in a draft should be supported by an appropriate source.\\\"}],\\\"$L32\\\"]}]]}],\\\"$L33\\\",\\\"$L34\\\"],\\\"$L35\\\",\\\"$L36\\\",\\\"$L37\\\"]}]]}]}]\\n\"])</script><script>self.__next_f.push([1,\"38:I[28792,[\\\"$13\\\",\\\"$1f\\\"],\\\"FAQ\\\"]\\n39:I[5014,[\\\"$13\\\",\\\"$1f\\\"],\\\"default\\\"]\\n32:[\\\"$\\\",\\\"p\\\",\\\"When reviewing sources, separate independent reporting from promotional material. Sponsored articles, advertorials, and content controlled by the company should be treated cautiously. A responsible Wikipedia consulting process includes a source review to identify what can be verified and where coverage gaps remain.\\\",{\\\"children\\\":\\\"When reviewing sources, separate independent reporting from promotional material. Sponsored articles, advertorials, and content controlled by the company should be treated cautiously. A responsible Wikipedia consulting process includes a source review to identify what can be verified and where coverage gaps remain.\\\"}]\\n\"])</script><script>self.__next_f.push([1,\"33:[\\\"$\\\",\\\"section\\\",\\\"neutrality-coi\\\",{\\\"id\\\":\\\"neutrality-coi\\\",\\\"className\\\":\\\"mb-10 scroll-mt-28\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"font-display text-2xl font-semibold text-navy md:text-3xl\\\",\\\"children\\\":\\\"Follow neutral point of view and disclosure expectations\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mt-4 space-y-4 text-base leading-8 text-muted\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",\\\"Wikipedia articles must be written from a neutral point of view. That means presenting verifiable information fairly, avoiding promotional language, and not emphasizing positive claims without balanced context supported by sources.\\\",{\\\"children\\\":\\\"Wikipedia articles must be written from a neutral point of view. That means presenting verifiable information fairly, avoiding promotional language, and not emphasizing positive claims without balanced context supported by sources.\\\"}],[\\\"$\\\",\\\"p\\\",\\\"If you have a close connection to the company, conflict-of-interest and paid-contribution considerations may apply. Transparency and policy compliance matter. In many cases, requesting feedback or using appropriate community processes is safer than directly publishing promotional content.\\\",{\\\"children\\\":\\\"If you have a close connection to the company, conflict-of-interest and paid-contribution considerations may apply. Transparency and policy compliance matter. In many cases, requesting feedback or using appropriate community processes is safer than directly publishing promotional content.\\\"}]]}]]}]\\n\"])</script><script>self.__next_f.push([1,\"34:[\\\"$\\\",\\\"section\\\",\\\"draft-and-submit\\\",{\\\"id\\\":\\\"draft-and-submit\\\",\\\"className\\\":\\\"mb-10 scroll-mt-28\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"font-display text-2xl font-semibold text-navy md:text-3xl\\\",\\\"children\\\":\\\"Draft carefully and choose a responsible submission path\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mt-4 space-y-4 text-base leading-8 text-muted\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",\\\"A good draft is concise, factual, and fully sourced. It should cover only what independent reliable sources support. Avoid unsourced claims about awards, rankings, market leadership, client lists, or impact. If the topic is borderline, Articles for Creation or community feedback may be appropriate depending on the situation.\\\",{\\\"children\\\":\\\"A good draft is concise, factual, and fully sourced. It should cover only what independent reliable sources support. Avoid unsourced claims about awards, rankings, market leadership, client lists, or impact. If the topic is borderline, Articles for Creation or community feedback may be appropriate depending on the situation.\\\"}],[\\\"$\\\",\\\"p\\\",\\\"No consultant, agency, or company can guarantee that Wikipedia editors will publish or retain an article. Editorial decisions are made independently by the Wikipedia community. The goal of a responsible process is to improve accuracy, compliance, and clarity—not to promise outcomes.\\\",{\\\"children\\\":\\\"No consultant, agency, or company can guarantee that Wikipedia editors will publish or retain an article. Editorial decisions are made independently by the Wikipedia community. The goal of a responsible process is to improve accuracy, compliance, and clarity—not to promise outcomes.\\\"}]]}]]}]\\n\"])</script><script>self.__next_f.push([1,\"35:[\\\"$\\\",\\\"section\\\",null,{\\\"id\\\":\\\"faqs\\\",\\\"className\\\":\\\"mb-10 scroll-mt-28\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"font-display text-2xl font-semibold text-navy md:text-3xl\\\",\\\"children\\\":\\\"Frequently asked questions\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mt-5\\\",\\\"children\\\":[\\\"$\\\",\\\"$L38\\\",null,{\\\"items\\\":[{\\\"q\\\":\\\"Can my company pay someone to create a Wikipedia page?\\\",\\\"a\\\":\\\"Paid help may be used for research, drafting guidance, or consulting, but paid-contribution and conflict-of-interest expectations should be handled transparently. Payment does not guarantee publication, approval, or retention.\\\"},{\\\"q\\\":\\\"What if my company does not have enough media coverage?\\\",\\\"a\\\":\\\"If independent reliable coverage is limited, the company may not meet Wikipedia’s notability expectations yet. In that case, focus on verifiable business milestones and independent coverage before attempting article creation.\\\"},{\\\"q\\\":\\\"Should I publish the page myself?\\\",\\\"a\\\":\\\"Direct publishing can be risky when there is a conflict of interest or the sourcing is weak. A careful review of sources, neutrality, and applicable disclosure guidance is recommended before choosing how to proceed.\\\"}]}]}]]}]\\n\"])</script><script>self.__next_f.push([1,\"36:[\\\"$\\\",\\\"section\\\",null,{\\\"id\\\":\\\"references\\\",\\\"className\\\":\\\"mb-10 scroll-mt-28 rounded-3xl border border-border bg-surface p-6\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"font-display text-2xl font-semibold text-navy\\\",\\\"children\\\":\\\"References\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-3 text-sm leading-6 text-muted\\\",\\\"children\\\":\\\"External references are provided for general guidance. Wikipedia policies and community practices can change, so review the current source pages before making decisions.\\\"}],[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"mt-4 space-y-2 text-sm\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"https://en.wikipedia.org/wiki/Wikipedia:Notability\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://en.wikipedia.org/wiki/Wikipedia:Notability\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\