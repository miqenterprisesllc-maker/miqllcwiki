eaServed\":[\"US\",\"Worldwide\"],\"availableLanguage\":[\"English\",\"en\"]},{\"@type\":\"ContactPoint\",\"telephone\":\"+1 (914) 730-2443\",\"contactType\":\"customer service\",\"contactOption\":\"TollFree\",\"areaServed\":\"Worldwide\",\"availableLanguage\":[\"English\"]}]}</script><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"WebSite\",\"@id\":\"https://miqllcwiki.com/#website\",\"name\":\"MIQ LLC (miqllcwiki.com)\",\"alternateName\":[\"MIQ\",\"MIQ LLC\",\"MIQ Enterprises\",\"MIQ Enterprises LLC\",\"MIQ LLC Wiki\",\"miqllcwiki\",\"miqllcwiki.com\",\"MIQ digital services\",\"MIQ Wikipedia consulting\"],\"url\":\"https://miqllcwiki.com\",\"description\":\"MIQ LLC (legal entity: MIQ Enterprises LLC) is an international digital services and technology solutions company delivering professional Wikipedia consulting, Wikipedia page creation guidance, Wikipedia editing and notability research, SEO, AEO, GEO, digital marketing, website development, branding, reputation management, and business technology solutions for clients in the United States and worldwide.\",\"publisher\":{\"@id\":\"https://miqllcwiki.com/#organization\"},\"inLanguage\":\"en-US\",\"potentialAction\":{\"@type\":\"SearchAction\",\"target\":{\"@type\":\"EntryPoint\",\"urlTemplate\":\"https://miqllcwiki.com/blog?search={search_term_string}\"},\"query-input\":\"required name=search_term_string\"}}</script><header class=\"sticky top-0 z-50 border-b border-border/70 bg-white/88 backdrop-blur\"><div class=\"container-tight flex h-[72px] items-center justify-between gap-4\"><a class=\"flex items-center gap-3\" aria-label=\"MIQ LLC home\" href=\"/\"><svg viewBox=\"0 0 64 64\" fill=\"none\" aria-hidden=\"true\" class=\"h-9 w-9\"><rect width=\"64\" height=\"64\" rx=\"16\" fill=\"#0B1B33\"></rect><path d=\"M18 44V20h6.2l7.8 12.2L39.8 20H46v24h-5.7V29.4l-8.3 12.8-8.3-12.8V44H18Z\" fill=\"white\"></path><path d=\"M46 44c0-4.2 3.2-7 7.6-7 .1 0 .3 0 .4 0v5c-.2 0-.4-.1-.7-.1-1.6 0-2.7.8-2.7 2.5V44H46Z\" fill=\"#C8A24A\"></path><circle cx=\"48.5\" cy=\"17.5\" r=\"4.5\" fill=\"#3B82F6\"></circle></svg><span class=\"font-display text-base font-semibold tracking-tight text-navy md:text-lg\">MIQ LLC</span></a><nav class=\"hidden items-center gap-1 md:flex\" aria-label=\"Main\"><a class=\"rounded-full px-3 py-2 text-sm font-medium text-charcoal transition hover:bg-surface hover:text-navy\" href=\"/\">Home</a><a class=\"rounded-full px-3 py-2 text-sm font-medium text-charcoal transition hover:bg-surface hover:text-navy\" href=\"/about\">About</a><a class=\"rounded-full px-3 py-2 text-sm font-medium text-charcoal transition hover:bg-surface hover:text-navy\" href=\"/services\">Services</a><a class=\"rounded-full px-3 py-2 text-sm font-medium text-charcoal transition hover:bg-surface hover:text-navy\" href=\"/portfolio\">Portfolio</a><a class=\"rounded-full px-3 py-2 text-sm font-medium text-charcoal transition hover:bg-surface hover:text-navy\" href=\"/blog\">Insights</a><a class=\"rounded-full px-3 py-2 text-sm font-medium text-charcoal transition hover:bg-surface hover:text-navy\" href=\"/contact\">Contact</a></nav><div class=\"hidden md:block\"><a class=\"inline-flex items-center rounded-full bg-navy px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-navy-2\" href=\"/contact\">Get a Free Consultation</a></div><button class=\"inline-flex rounded-lg p-2 text-navy md:hidden\" aria-expanded=\"false\" aria-label=\"Toggle menu\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-menu\" aria-hidden=\"true\"><path d=\"M4 5h16\"></path><path d=\"M4 12h16\"></path><path d=\"M4 19h16\"></path></svg></button></div></header><main class=\"flex-1\"><!--&--><!--&--><!--&--><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"@id\":\"https://miqllcwiki.com/blog/reliable-sources-for-wikipedia#webpage\",\"name\":\"What Are Reliable Sources for Wikipedia?\",\"description\":\"A clear guide to reliable, independent sources on Wikipedia, including what usually works, what to avoid, and how to evaluate coverage quality.\",\"url\":\"https://miqllcwiki.com/blog/reliable-sources-for-wikipedia\",\"isPartOf\":{\"@id\":\"https://miqllcwiki.com/#website\"},\"about\":{\"@id\":\"https://miqllcwiki.com/#organization\"},\"inLanguage\":\"en-US\"}</script><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://miqllcwiki.com/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Insights\",\"item\":\"https://miqllcwiki.com/blog\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"What Are Reliable Sources for Wikipedia?\",\"item\":\"https://miqllcwiki.com/blog/reliable-sources-for-wikipedia\"}]}</script><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"BlogPosting\",\"@id\":\"https://miqllcwiki.com/blog/reliable-sources-for-wikipedia#article\",\"headline\":\"What Are Reliable Sources for Wikipedia?\",\"description\":\"A clear guide to reliable, independent sources on Wikipedia, including what usually works, what to avoid, and how to evaluate coverage quality.\",\"url\":\"https://miqllcwiki.com/blog/reliable-sources-for-wikipedia\",\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://miqllcwiki.com/blog/reliable-sources-for-wikipedia#webpage\"},\"author\":{\"@type\":\"Organization\",\"@id\":\"https://miqllcwiki.com/#organization\",\"name\":\"MIQ LLC\"},\"publisher\":{\"@type\":\"Organization\",\"@id\":\"https://miqllcwiki.com/#organization\",\"name\":\"MIQ LLC\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://miqllcwiki.com/favicon.svg\"}},\"datePublished\":\"2026-11-10\",\"dateModified\":\"2026-11-10\",\"inLanguage\":\"en-US\",\"isPartOf\":{\"@id\":\"https://miqllcwiki.com/#website\"},\"keywords\":[\"reliable sources for Wikipedia\",\"independent sources Wikipedia\",\"Wikipedia citation research\",\"Wikipedia notability sources\",\"Wikipedia article sources\"],\"hasPart\":{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Can company websites be used as Wikipedia sources?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Company websites are primary or self-published sources about the subject. They may be useful for limited, uncontroversial facts in some cases, but they are usually weak evidence for notability and should not replace independent secondary coverage.\"}},{\"@type\":\"Question\",\"name\":\"Are news articles always reliable?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Not automatically. Reliability depends on the publication, editorial standards, and the type of claim. Reputable outlets are often useful, but each source should still be evaluated in context.\"}},{\"@type\":\"Question\",\"name\":\"How many sources are needed for a Wikipedia page?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"There is no fixed number that guarantees eligibility. The key issue is whether reliable, independent sources provide significant coverage and support the article’s content. Quality, independence, and relevance matter more than a raw count.\"}}]}}</script><section class=\"hero-grid text-white\"><div class=\"grid-lines\"><div class=\"container-tight py-20 md:py-24\"><nav aria-label=\"Breadcrumb\" class=\"mb-4 text-sm text-white/65\"><ol class=\"flex flex-wrap items-center gap-2\"><li><a class=\"hover:text-white\" href=\"/\">Home</a></li><li aria-hidden=\"true\">/</li><li><a class=\"hover:text-white\" href=\"/blog\">Insights</a></li><li aria-hidden=\"true\">/</li><li class=\"text-white/85\">What Are Reliable Sources for Wikipedia?</li></ol></nav><p class=\"mb-3 text-xs font-semibold uppercase tracking-[0.22em] text-electric\"><span class=\"text-sky-300\">Wikipedia<!-- --> Guide</span></p><h1 class=\"font-display max-w-4xl text-4xl font-semibold md:text-5xl\">What Are Reliable Sources for Wikipedia?</h1><p class=\"mt-5 max-w-3xl text-lg text-white/78\">Reliable sources help Wikipedia editors verify information. In most cases, the strongest sources are independent secondary publications with editorial oversight and a reputation for accuracy. Context matters, so each source should be evaluated for reliability, independence, and relevance.</p><p class=\"mt-4 text-sm text-white/60\">Published <!-- -->2026-11-10<!-- --> · Updated <!-- -->2026-11-10</p></div></div></section><section class=\"section-pad \"><div class=\"container-tight grid gap-10 lg:grid-cols-[.28fr_.72fr]\"><aside class=\"lg:sticky lg:top-28 lg:self-start\"><div class=\"rounded-3xl border border-border bg-surface p-5\"><p class=\"font-display text-sm font-semibold uppercase tracking-[0.14em] text-electric\">On this page</p><ul class=\"mt-4 space-y-2 text-sm text-muted\"><li><a href=\"#what-reliable-means\" class=\"hover:text-navy\">What makes a source reliable</a></li><li><a href=\"#independence\" class=\"hover:text-navy\">Independence is especially important</a></li><li><a href=\"#evaluate-quality\" class=\"hover:text-navy\">How to evaluate source quality</a></li><li><a href=\"#citation-research\" class=\"hover:text-navy\">Using source research in a responsible draft</a></li><li><a href=\"#faqs\" class=\"hover:text-navy\">Frequently asked questions</a></li><li><a href=\"#references\" class=\"hover:text-navy\">References</a></li></ul></div></aside><article class=\"max-w-3xl\"><section id=\"what-reliable-means\" class=\"mb-10 scroll-mt-28\"><h2 class=\"font-display text-2xl font-semibold text-navy md:text-3xl\">What makes a source reliable</h2><div class=\"mt-4 space-y-4 text-base leading-8 text-muted\"><p>Reliability on Wikipedia depends on context, but reliable sources generally have a track record of accuracy, editorial oversight, and accountability. The question is not just whether a source exists, but whether it is appropriate support for the specific claim being made.</p><p>Different topics require different kinds of sources. A claim about a company’s public history may be supported by reputable news reporting, while technical or academic claims may require more specialized publications. Sources should be matched to the statement they support.</p></div></section><section id=\"independence\" class=\"mb-10 scroll-mt-28\"><h2 class=\"font-display text-2xl font-semibold text-navy md:text-3xl\">Independence is especially important</h2><div class=\"mt-4 space-y-4 text-base leading-8 text-muted\"><p>For notability and company biographies, independence is critical. Sources produced by the subject, paid for by the subject, or directly controlled by the subject usually carry less weight as evidence of independent notability.</p><p>Examples that often require caution include press releases, company blog posts, sponsored content, advertorials, and interviews republished without independent reporting. These materials may still be useful for limited facts in some contexts, but they are rarely enough to establish notability.</p></div></section><section id=\"evaluate-quality\" class=\"mb-10 scroll-mt-28\"><h2 class=\"font-display text-2xl font-semibold text-navy md:text-3xl\">How to evaluate source quality</h2><div class=\"mt-4 space-y-4 text-base leading-8 text-muted\"><p>Look for depth and substance. Does the source discuss the subject in detail, or is it a passing mention? Is the publisher reputable? Is the content editorially independent? Does the source provide context, reporting, or analysis rather than repeating promotional claims?</p><p>It is also useful to review multiple sources together. A pattern of independent coverage from reputable outlets can provide stronger support than isolated mentions. A source review should document what each source supports and identify unsupported statements.</p></div></section><section id=\"citation-research\" class=\"mb-10 scroll-mt-28\"><h2 class=\"font-display text-2xl font-semibold text-navy md:text-3xl\">Using source research in a responsible draft</h2><div class=\"mt-4 space-y-4 text-base leading-8 text-muted\"><p>Citation research should shape the draft. Start by collecting sources, then write only what those sources verify. Avoid adding claims first and searching for citations later, as that approach can lead to weak sourcing or promotional framing.</p><p>If the sources do not support a claim, the claim should be removed, narrowed, or rewritten. This discipline is central to Wikipedia article preparation and is one of the main ways to reduce editorial risk.</p></div></section><section id=\"faqs\" class=\"mb-10 scroll-mt-28\"><h2 class=\"font-display text-2xl font-semibold text-navy md:text-3xl\">Frequently asked questions</h2><div class=\"mt-5\"><div class=\"divide-y divide-border rounded-2xl border border-border bg-white\"><details class=\"group\" open=\"\"><summary class=\"flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-left [&amp;::-webkit-details-marker]:hidden\"><span class=\"font-medium text-navy\">Can company websites be used as Wikipedia sources?</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down shrink-0 text-muted transition group-open:rotate-180\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></summary><div class=\"px-5 pb-5 text-sm leading-6 text-muted\">Company websites are primary or self-published sources about the subject. They may be useful for limited, uncontroversial facts in some cases, but they are usually weak evidence for notability and should not replace independent secondary coverage.</div></details><details class=\"group\"><summary class=\"flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-left [&amp;::-webkit-details-marker]:hidden\"><span class=\"font-medium text-navy\">Are news articles always reliable?</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down shrink-0 text-muted transition group-open:rotate-180\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></summary><div class=\"px-5 pb-5 text-sm leading-6 text-muted\">Not automatically. Reliability depends on the publication, editorial standards, and the type of claim. Reputable outlets are often useful, but each source should still be evaluated in context.</div></details><details class=\"group\"><summary class=\"flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-left [&amp;::-webkit-details-marker]:hidden\"><span class=\"font-medium text-navy\">How many sources are needed for a Wikipedia page?</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down shrink-0 text-muted transition group-open:rotate-180\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></summary><div class=\"px-5 pb-5 text-sm leading-6 text-muted\">There is no fixed number that guarantees eligibility. The key issue is whether reliable, independent sources provide significant coverage and support the article’s content. Quality, independence, and relevance matter more than a raw count.</div></details></div></div></section><section id=\"references\" class=\"mb-10 scroll-mt-28 rounded-3xl border border-border bg-surface p-6\"><h2 class=\"font-display text-2xl font-semibold text-navy\">References</h2><p class=\"mt-3 text-sm leading-6 text-muted\">External references are provided for general guidance. Wikipedia policies and community practices can change, so review the current source pages before making decisions.</p><ul class=\"mt-4 space-y-2 text-sm\"><li><a href=\"https://en.wikipedia.org/wiki/Wikipedia:Reliable_sources\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-electric hover:underline\">Wikipedia: Reliable sources</a></li><li><a href=\"https://en.wikipedia.org/wiki/Wikipedia:Independent_sources\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-electric hover:underline\">Wikipedia: Independent sources</a></li><li><a href=\"https://en.wikipedia.org/wiki/Wikipedia:Identifying_reliable_sources\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-electric hover:underline\">Wikipedia: Identifying reliable sources</a></li><li><a href=\"https://en.wikipedia.org/wiki/Wikipedia:Verifiability\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-electric hover:underline\">Wikipedia: Verifiability</a></li></ul></section><div class=\"rounded-3xl bg-navy p-7 text-white\"><p class=\"text-lg font-semibold\">Need help evaluating whether existing coverage supports a Wikipedia draft?</p><a class=\"mt-4 inline-flex items-center gap-1 rounded-full bg-white px-5 py-3 text-sm font-semibold text-navy\" href=\"/contact\">Request Citation and Source Research<!-- --> <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a></div></article></div></section><!--$--><!--/$--><!--/&--><!--/&--><!--/&--></main><footer class=\"border-t border-white/10 bg-navy text-white\"><div class=\"container-tight grid gap-10 py-14 md:grid-cols-2 lg:grid-cols-4\"><div><div class=\"flex items-center gap-3\"><svg viewBox=\"0 0 64 64\" fill=\"none\" aria-hidden=\"true\" class=\"h-9 w-9\"><rect width=\"64\" height=\"64\" rx=\"16\" fill=\"#0B1B33\"></rect><path d=\"M18 44V20h6.2l7.8 12.2L39.8 20H46v24h-5.7V29.4l-8.3 12.8-8.3-12.8V44H18Z\" fill=\"white\"></path><path d=\"M46 44c0-4.2 3.2-7 7.6-7 .1 0 .3 0 .4 0v5c-.2 0-.4-.1-.7-.1-1.6 0-2.7.8-2.7 2.5V44H46Z\" fill=\"#C8A24A\"></path><circle cx=\"48.5\" cy=\"17.5\" r=\"4.5\" fill=\"#3B82F6\"></circle></svg><span class=\"font-display text-lg font-semibold\">MIQ LLC</span></div><p class=\"mt-4 max-w-sm text-sm leading-6 text-white/72\">Your Vision. Our Digital Expertise.<!-- --> <!-- -->MIQ LLC (legal entity: MIQ Enterprises LLC) is an international digital services and technology solutions company delivering professional Wikipedia consulting, Wikipedia page creation guidance, Wikipedia editing and notability research, SEO, AEO, GEO, digital marketing, website development, branding, reputation management, and business technology solutions for clients in the United States and worldwide.</p></div><div><h3 class=\"font-display text-sm font-semibold uppercase tracking-[0.18em] text-gold\">Services</h3><ul class=\"mt-4 space-y-2 text-sm text-white/75\"><li><a class=\"hover:text-white\" href=\"/services/wikipedia-services\">Worldwide Wikipedia Services &amp; Consulting</a></li><li><a class=\"hover:text-white\" href=\"/services/seo-digital-marketing\">SEO &amp; Digital Marketing</a></li><li><a class=\"hover:text-white\" href=\"/services/website-development\">Website Development</a></li><li><a class=\"hover:text-white\" href=\"/services/online-reputation-management\">Online Reputation Management</a></li><li><a class=\"hover:text-white\" href=\"/services/branding-creative-solutions\">Branding &amp; Creative Solutions</a></li><li><a class=\"hover:text-white\" href=\"/services/business-technology-solutions\">Business &amp; Technology Solutions</a></li></ul></div><div><h3 class=\"font-display text-sm font-semibold uppercase tracking-[0.18em] text-gold\">Company</h3><ul class=\"mt-4 space-y-2 text-sm text-white/