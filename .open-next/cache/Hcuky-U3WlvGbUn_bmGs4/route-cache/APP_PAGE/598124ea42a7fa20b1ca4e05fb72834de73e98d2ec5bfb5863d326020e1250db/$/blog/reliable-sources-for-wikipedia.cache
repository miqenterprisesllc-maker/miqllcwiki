21\",{\"name\":\"twitter:card\",\"content\":\"summary_large_image\"}],[\"$\",\"meta\",\"22\",{\"name\":\"twitter:title\",\"content\":\"What Are Reliable Sources for Wikipedia? | MIQ LLC\"}],[\"$\",\"meta\",\"23\",{\"name\":\"twitter:description\",\"content\":\"A clear guide to reliable, independent sources on Wikipedia, including what usually works, what to avoid, and how to evaluate coverage quality.\"}],[\"$\",\"link\",\"24\",{\"rel\":\"shortcut icon\",\"href\":\"/favicon.svg\"}],[\"$\",\"link\",\"25\",{\"rel\":\"icon\",\"href\":\"/favicon.ico?favicon.117ezoe8m31dk.ico\",\"sizes\":\"48x48\",\"type\":\"image/x-icon\"}],[\"$\",\"link\",\"26\",{\"rel\":\"icon\",\"href\":\"/favicon.svg\"}],[\"$\",\"link\",\"27\",{\"rel\":\"apple-touch-icon\",\"href\":\"/favicon.svg\"}],[\"$\",\"$L1f\",\"28\",{}]]\n1a:false\n20:\"/_next/static/chunks/3don6yfijp8pi.js\"\n21:\"/_next/static/chunks/0hlscisrmz_ud.js\"\n22:I[22016,[\"$20\",\"$21\"],\"\"]\n1d:[\"$\",\"section\",null,{\"className\":\"hero-grid text-white\",\"children\":[\"$\",\"div\",null,{\"className\":\"grid-lines\",\"children\":[\"$\",\"div\",null,{\"className\":\"container-tight py-20 md:py-24\",\"children\":[[\"$\",\"nav\",null,{\"aria-label\":\"Breadcrumb\",\"className\":\"mb-4 text-sm text-white/65\",\"children\":[\"$\",\"ol\",null,{\"className\":\"flex flex-wrap items-center gap-2\",\"children\":[[\"$\",\"li\",null,{\"children\":[\"$\",\"$L22\",null,{\"href\":\"/\",\"className\":\"hover:text-white\",\"children\":\"Home\"}]}],[\"$\",\"li\",null,{\"aria-hidden\":\"true\",\"children\":\"/\"}],[\"$\",\"li\",null,{\"children\":[\"$\",\"$L22\",null,{\"href\":\"/blog\",\"className\":\"hover:text-white\",\"children\":\"Insights\"}]}],[\"$\",\"li\",null,{\"aria-hidden\":\"true\",\"children\":\"/\"}],[\"$\",\"li\",null,{\"className\":\"text-white/85\",\"children\":\"What Are Reliable Sources for Wikipedia?\"}]]}]}],[\"$\",\"p\",null,{\"className\":\"mb-3 text-xs font-semibold uppercase tracking-[0.22em] text-electric\",\"children\":[\"$\",\"span\",null,{\"className\":\"text-sky-300\",\"children\":[\"Wikipedia\",\" Guide\"]}]}],[\"$\",\"h1\",null,{\"className\":\"font-display max-w-4xl text-4xl font-semibold md:text-5xl\",\"children\":\"What Are Reliable Sources for Wikipedia?\"}],[\"$\",\"p\",null,{\"className\":\"mt-5 max-w-3xl text-lg text-white/78\",\"children\":\"Reliable sources help Wikipedia editors verify information. In most cases, the strongest sources are independent secondary publications with editorial oversight and a reputation for accuracy. Context matters, so each source should be evaluated for reliability, independence, and relevance.\"}],[\"$\",\"p\",null,{\"className\":\"mt-4 text-sm text-white/60\",\"children\":[\"Published \",\"2026-11-10\",\" · Updated \",\"2026-11-10\"]}]]}]}]}]\n1e:[\"$\",\"section\",null,{\"className\":\"section-pad \",\"children\":[\"$\",\"div\",null,{\"className\":\"container-tight grid gap-10 lg:grid-cols-[.28fr_.72fr]\",\"children\":[[\"$\",\"aside\",null,{\"className\":\"lg:sticky lg:top-28 lg:self-start\",\"children\":[\"$\",\"div\",null,{\"className\":\"rounded-3xl border border-border bg-surface p-5\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-display text-sm font-semibold uppercase tracking-[0.14em] text-electric\",\"children\":\"On this page\"}],[\"$\",\"ul\",null,{\"className\":\"mt-4 space-y-2 text-sm text-muted\",\"children\":[[[\"$\",\"li\",\"what-reliable-means\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#what-reliable-means\",\"className\":\"hover:text-navy\",\"children\":\"What makes a source reliable\"}]}],[\"$\",\"li\",\"independence\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#independence\",\"className\":\"hover:text-navy\",\"children\":\"Independence is especially important\"}]}],[\"$\",\"li\",\"evaluate-quality\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#evaluate-quality\",\"className\":\"hover:text-navy\",\"children\":\"How to evaluate source quality\"}]}],[\"$\",\"li\",\"citation-research\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#citation-research\",\"className\":\"hover:text-navy\",\"children\":\"Using source research in a responsible draft\"}]}]],[\"$\",\"li\",null,{\"children\":[\"$\",\"a\",null,{\"href\":\"#faqs\",\"className\":\"hover:text-navy\",\"children\":\"Frequently asked questions\"}]}],[\"$\",\"li\",null,{\"children\":[\"$\",\"a\",null,{\"href\":\"#references\",\"className\":\"hover:text-navy\",\"children\":\"References\"}]}]]}]]}]}],[\"$\",\"article\",null,{\"className\":\"max-w-3xl\",\"children\":[[[\"$\",\"section\",\"what-reliable-means\",{\"id\":\"what-reliable-means\",\"className\":\"mb-10 scroll-mt-28\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-display text-2xl font-semibold text-navy md:text-3xl\",\"children\":\"What makes a source reliable\"}],[\"$\",\"div\",null,{\"className\":\"mt-4 space-y-4 text-base leading-8 text-muted\",\"children\":[[\"$\",\"p\",\"Reliability on Wikipedia depends on context, but reliable sources generally have a track record of accuracy, editorial oversight, and accountability. The question is not just whether a source exists, but whether it is appropriate support for the specific claim being made.\",{\"children\":\"Reliability on Wikipedia depends on context, but reliable sources generally have a track record of accuracy, editorial oversight, and accountability. The question is not just whether a source exists, but whether it is appropriate support for the specific claim being made.\"}],[\"$\",\"p\",\"Different topics require different kinds of sources. A claim about a company’s public history may be supported by reputable news reporting, while technical or academic claims may require more specialized publications. Sources should be matched to the statement they support.\",{\"children\":\"Different topics require different kinds of sources. A claim about a company’s public history may be supported by reputable news reporting, while technical or academic claims may require more specialized publications. Sources should be matched to the statement they support.\"}]]}]]}],[\"$\",\"section\",\"independence\",{\"id\":\"independence\",\"className\":\"mb-10 scroll-mt-28\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-display text-2xl font-semibold text-navy md:text-3xl\",\"children\":\"Independence is especially important\"}],[\"$\",\"div\",null,{\"className\":\"mt-4 space-y-4 text-base leading-8 text-muted\",\"children\":[[\"$\",\"p\",\"For notability and company biographies, independence is critical. Sources produced by the subject, paid for by the subject, or directly controlled by the subject usually carry less weight as evidence of independent notability.\",{\"children\":\"For notability and company biographies, independence is critical. Sources produced by the subject, paid for by the subject, or directly controlled by the subject usually carry less weight as evidence of independent notability.\"}],\"$L23\"]}]]}],\"$L24\",\"$L25\"],\"$L26\",\"$L27\",\"$L28\"]}]]}]}]\n29:I[28792,[\"$20\",\"$21\"],\"FAQ\"]\n2a:I[5014,[\"$20\",\"$21\"],\"default\"]\n23:[\"$\",\"p\",\"Examples that often require caution include press releases, company blog posts, sponsored content, advertorials, and interviews republished without independent reporting. These materials may still be useful for limited facts in some contexts, but they are rarely enough to establish notability.\",{\"children\":\"Examples that often require caution include press releases, company blog posts, sponsored content, advertorials, and interviews republished without independent reporting. These materials may still be useful for limited facts in some contexts, but they are rarely enough to establish notability.\"}]\n24:[\"$\",\"section\",\"evaluate-quality\",{\"id\":\"evaluate-quality\",\"className\":\"mb-10 scroll-mt-28\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-display text-2xl font-semibold text-navy md:text-3xl\",\"children\":\"How to evaluate source quality\"}],[\"$\",\"div\",null,{\"className\":\"mt-4 space-y-4 text-base leading-8 text-muted\",\"children\":[[\"$\",\"p\",\"Look for depth and substance. Does the source discuss the subject in detail, or is it a passing mention? Is the publisher reputable? Is the content editorially independent? Does the source provide context, reporting, or analysis rather than repeating promotional claims?\",{\"children\":\"Look for depth and substance. Does the source discuss the subject in detail, or is it a passing mention? Is the publisher reputable? Is the content editorially independent? Does the source provide context, reporting, or analysis rather than repeating promotional claims?\"}],[\"$\",\"p\",\"It is also useful to review multiple sources together. A pattern of independent coverage from reputable outlets can provide stronger support than isolated mentions. A source review should document what each source supports and identify unsupported statements.\",{\"children\":\"It is also useful to review multiple sources together. A pattern of independent coverage from reputable outlets can provide stronger support than isolated mentions. A source review should document what each source supports and identify unsupported statements.\"}]]}]]}]\n25:[\"$\",\"section\",\"citation-research\",{\"id\":\"citation-research\",\"className\":\"mb-10 scroll-mt-28\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-display text-2xl font-semibold text-navy md:text-3xl\",\"children\":\"Using source research in a responsible draft\"}],[\"$\",\"div\",null,{\"className\":\"mt-4 space-y-4 text-base leading-8 text-muted\",\"children\":[[\"$\",\"p\",\"Citation research should shape the draft. Start by collecting sources, then write only what those sources verify. Avoid adding claims first and searching for citations later, as that approach can lead to weak sourcing or promotional framing.\",{\"children\":\"Citation research should shape the draft. Start by collecting sources, then write only what those sources verify. Avoid adding claims first and searching for citations later, as that approach can lead to weak sourcing or promotional framing.\"}],[\"$\",\"p\",\"If the sources do not support a claim, the claim should be removed, narrowed, or rewritten. This discipline is central to Wikipedia article preparation and is one of the main ways to reduce editorial risk.\",{\"children\":\"If the sources do not support a claim, the claim should be removed, narrowed, or rewritten. This discipline is central to Wikipedia article preparation and is one of the main ways to reduce editorial risk.\"}]]}]]}]\n26:[\"$\",\"section\",null,{\"id\":\"faqs\",\"className\":\"mb-10 scroll-mt-28\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-display text-2xl font-semibold text-navy md:text-3xl\",\"children\":\"Frequently asked questions\"}],[\"$\",\"div\",null,{\"className\":\"mt-5\",\"children\":[\"$\",\"$L29\",null,{\"items\":[{\"q\":\"Can company websites be used as Wikipedia sources?\",\"a\":\"Company websites are primary or self-published sources about the subject. They may be useful for limited, uncontroversial facts in some cases, but they are usually weak evidence for notability and should not replace independent secondary coverage.\"},{\"q\":\"Are news articles always reliable?\",\"a\":\"Not automatically. Reliability depends on the publication, editorial standards, and the type of claim. Reputable outlets are often useful, but each source should still be evaluated in context.\"},{\"q\":\"How many sources are needed for a Wikipedia page?\",\"a\":\"There is no fixed number that guarantees eligibility. The key issue is whether reliable, independent sources provide significant coverage and support the article’s content. Quality, independence, and relevance matter more than a raw count.\"}]}]}]]}]\n27:[\"$\",\"section\",null,{\"id\":\"references\",\"className\":\"mb-10 scroll-mt-28 rounded-3xl border border-border bg-surface p-6\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-display text-2xl font-semibold text-navy\",\"children\":\"References\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-sm leading-6 text-muted\",\"children\":\"External references are provided for general guidance. Wikipedia policies and community practices can change, so review the current source pages before making decisions.\"}],[\"$\",\"ul\",null,{\"className\":\"mt-4 space-y-2 text-sm\",\"children\":[[\"$\",\"li\",\"https://en.wikipedia.org/wiki/Wikipedia:Reliable_sources\",{\"children\":[\"$\",\"a\",null,{\"href\":\"https://en.wikipedia.org/wiki/Wikipedia:Reliable_sources\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-electric hover:underline\",\"children\":\"Wikipedia: Reliable sources\"}]}],[\"$\",\"li\",\"https://en.wikipedia.org/wiki/Wikipedia:Independent_sources\",{\"children\":[\"$\",\"a\",null,{\"href\":\"https://en.wikipedia.org/wiki/Wikipedia:Independent_sources\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-electric hover:underline\",\"children\":\"Wikipedia: Independent sources\"}]}],[\"$\",\"li\",\"https://en.wikipedia.org/wiki/Wikipedia:Identifying_reliable_sources\",{\"children\":[\"$\",\"a\",null,{\"href\":\"https://en.wikipedia.org/wiki/Wikipedia:Identifying_reliable_sources\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-electric hover:underline\",\"children\":\"Wikipedia: Identifying reliable sources\"}]}],[\"$\",\"li\",\"https://en.wikipedia.org/wiki/Wikipedia:Verifiability\",{\"children\":[\"$\",\"a\",null,{\"href\":\"https://en.wikipedia.org/wiki/Wikipedia:Verifiability\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-electric hover:underline\",\"children\":\"Wikipedia: Verifiability\"}]}]]}]]}]\n28:[\"$\",\"div\",null,{\"className\":\"rounded-3xl bg-navy p-7 text-white\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-lg font-semibold\",\"children\":\"Need help evaluating whether existing coverage supports a Wikipedia draft?\"}],[\"$\",\"$L22\",null,{\"href\":\"/contact\",\"className\":\"mt-4 inline-flex items-center gap-1 rounded-full bg-white px-5 py-3 text-sm font-semibold text-navy\",\"children\":[\"Request Citation and Source Research\",\" \",[\"$\",\"$L2a\",null,{\"icon\":{\"name\":\"arrow-right\",\"size\":24,\"node\":[[\"path\",{\"d\":\"M5 12h14\",\"key\":\"1ays0h\"}],[\"path\",{\"d\":\"m12 5 7 7-7 7\",\"key\":\"xquz4c\"}]]},\"size\":16}]]}]]}]\n19:1695\na:\"$undefined\"\n6:\"$undefined\"\n17:\"$undefined\"\n10:\"$undefined\"\n"}}