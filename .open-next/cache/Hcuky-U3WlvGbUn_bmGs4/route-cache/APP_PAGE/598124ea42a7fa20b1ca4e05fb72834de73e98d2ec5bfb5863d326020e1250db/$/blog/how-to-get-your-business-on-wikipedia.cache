\"21\",{\"name\":\"twitter:card\",\"content\":\"summary_large_image\"}],[\"$\",\"meta\",\"22\",{\"name\":\"twitter:title\",\"content\":\"How to Get Your Business on Wikipedia | MIQ LLC\"}],[\"$\",\"meta\",\"23\",{\"name\":\"twitter:description\",\"content\":\"A realistic guide to getting a business represented on Wikipedia, including eligibility, source requirements, neutral writing, and responsible next steps.\"}],[\"$\",\"link\",\"24\",{\"rel\":\"shortcut icon\",\"href\":\"/favicon.svg\"}],[\"$\",\"link\",\"25\",{\"rel\":\"icon\",\"href\":\"/favicon.ico?favicon.117ezoe8m31dk.ico\",\"sizes\":\"48x48\",\"type\":\"image/x-icon\"}],[\"$\",\"link\",\"26\",{\"rel\":\"icon\",\"href\":\"/favicon.svg\"}],[\"$\",\"link\",\"27\",{\"rel\":\"apple-touch-icon\",\"href\":\"/favicon.svg\"}],[\"$\",\"$L1f\",\"28\",{}]]\n1a:false\n20:\"/_next/static/chunks/3don6yfijp8pi.js\"\n21:\"/_next/static/chunks/0hlscisrmz_ud.js\"\n22:I[22016,[\"$20\",\"$21\"],\"\"]\n1d:[\"$\",\"section\",null,{\"className\":\"hero-grid text-white\",\"children\":[\"$\",\"div\",null,{\"className\":\"grid-lines\",\"children\":[\"$\",\"div\",null,{\"className\":\"container-tight py-20 md:py-24\",\"children\":[[\"$\",\"nav\",null,{\"aria-label\":\"Breadcrumb\",\"className\":\"mb-4 text-sm text-white/65\",\"children\":[\"$\",\"ol\",null,{\"className\":\"flex flex-wrap items-center gap-2\",\"children\":[[\"$\",\"li\",null,{\"children\":[\"$\",\"$L22\",null,{\"href\":\"/\",\"className\":\"hover:text-white\",\"children\":\"Home\"}]}],[\"$\",\"li\",null,{\"aria-hidden\":\"true\",\"children\":\"/\"}],[\"$\",\"li\",null,{\"children\":[\"$\",\"$L22\",null,{\"href\":\"/blog\",\"className\":\"hover:text-white\",\"children\":\"Insights\"}]}],[\"$\",\"li\",null,{\"aria-hidden\":\"true\",\"children\":\"/\"}],[\"$\",\"li\",null,{\"className\":\"text-white/85\",\"children\":\"How to Get Your Business on Wikipedia\"}]]}]}],[\"$\",\"p\",null,{\"className\":\"mb-3 text-xs font-semibold uppercase tracking-[0.22em] text-electric\",\"children\":[\"$\",\"span\",null,{\"className\":\"text-sky-300\",\"children\":[\"Wikipedia\",\" Guide\"]}]}],[\"$\",\"h1\",null,{\"className\":\"font-display max-w-4xl text-4xl font-semibold md:text-5xl\",\"children\":\"How to Get Your Business on Wikipedia\"}],[\"$\",\"p\",null,{\"className\":\"mt-5 max-w-3xl text-lg text-white/78\",\"children\":\"Getting a business on Wikipedia is possible only when the topic meets Wikipedia’s standards, especially notability and verifiability. The process should focus on independent reliable sources, neutral presentation, and policy compliance rather than promotional placement.\"}],[\"$\",\"p\",null,{\"className\":\"mt-4 text-sm text-white/60\",\"children\":[\"Published \",\"2026-11-10\",\" · Updated \",\"2026-11-10\"]}]]}]}]}]\n1e:[\"$\",\"section\",null,{\"className\":\"section-pad \",\"children\":[\"$\",\"div\",null,{\"className\":\"container-tight grid gap-10 lg:grid-cols-[.28fr_.72fr]\",\"children\":[[\"$\",\"aside\",null,{\"className\":\"lg:sticky lg:top-28 lg:self-start\",\"children\":[\"$\",\"div\",null,{\"className\":\"rounded-3xl border border-border bg-surface p-5\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-display text-sm font-semibold uppercase tracking-[0.14em] text-electric\",\"children\":\"On this page\"}],[\"$\",\"ul\",null,{\"className\":\"mt-4 space-y-2 text-sm text-muted\",\"children\":[[[\"$\",\"li\",\"eligibility\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#eligibility\",\"className\":\"hover:text-navy\",\"children\":\"Confirm whether the business is eligible\"}]}],[\"$\",\"li\",\"prepare-information\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#prepare-information\",\"className\":\"hover:text-navy\",\"children\":\"Prepare verifiable information\"}]}],[\"$\",\"li\",\"policy-compliance\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#policy-compliance\",\"className\":\"hover:text-navy\",\"children\":\"Use a policy-compliant approach\"}]}],[\"$\",\"li\",\"after-publication\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#after-publication\",\"className\":\"hover:text-navy\",\"children\":\"Plan for maintenance, not just creation\"}]}]],[\"$\",\"li\",null,{\"children\":[\"$\",\"a\",null,{\"href\":\"#faqs\",\"className\":\"hover:text-navy\",\"children\":\"Frequently asked questions\"}]}],[\"$\",\"li\",null,{\"children\":[\"$\",\"a\",null,{\"href\":\"#references\",\"className\":\"hover:text-navy\",\"children\":\"References\"}]}]]}]]}]}],[\"$\",\"article\",null,{\"className\":\"max-w-3xl\",\"children\":[[[\"$\",\"section\",\"eligibility\",{\"id\":\"eligibility\",\"className\":\"mb-10 scroll-mt-28\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-display text-2xl font-semibold text-navy md:text-3xl\",\"children\":\"Confirm whether the business is eligible\"}],[\"$\",\"div\",null,{\"className\":\"mt-4 space-y-4 text-base leading-8 text-muted\",\"children\":[[\"$\",\"p\",\"Wikipedia does not create articles simply because a business exists or wants visibility. Editors generally expect significant coverage in reliable, independent secondary sources. That coverage should help readers understand why the business is notable beyond routine commercial activity.\",{\"children\":\"Wikipedia does not create articles simply because a business exists or wants visibility. Editors generally expect significant coverage in reliable, independent secondary sources. That coverage should help readers understand why the business is notable beyond routine commercial activity.\"}],[\"$\",\"p\",\"A source review is the best starting point. Gather independent articles, reports, or publications that discuss the business in substance. If coverage is thin, indirect, or mostly self-published, the business may not yet be ready for a standalone article.\",{\"children\":\"A source review is the best starting point. Gather independent articles, reports, or publications that discuss the business in substance. If coverage is thin, indirect, or mostly self-published, the business may not yet be ready for a standalone article.\"}]]}]]}],[\"$\",\"section\",\"prepare-information\",{\"id\":\"prepare-information\",\"className\":\"mb-10 scroll-mt-28\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-display text-2xl font-semibold text-navy md:text-3xl\",\"children\":\"Prepare verifiable information\"}],[\"$\",\"div\",null,{\"className\":\"mt-4 space-y-4 text-base leading-8 text-muted\",\"children\":[[\"$\",\"p\",\"Once eligibility looks plausible, organize facts that can be supported by independent sources. Typical verifiable topics may include founding details reported by reliable outlets, major products or services covered by third parties, significant partnerships, funding, expansions, or other developments with independent coverage.\",{\"children\":\"Once eligibility looks plausible, organize facts that can be supported by independent sources. Typical verifiable topics may include founding details reported by reliable outlets, major products or services covered by third parties, significant partnerships, funding, expansions, or other developments with independent coverage.\"}],\"$L23\"]}]]}],\"$L24\",\"$L25\"],\"$L26\",\"$L27\",\"$L28\"]}]]}]}]\n29:I[28792,[\"$20\",\"$21\"],\"FAQ\"]\n2a:I[5014,[\"$20\",\"$21\"],\"default\"]\n23:[\"$\",\"p\",\"Avoid preparing a draft around marketing claims. Statements about being the best, leading, trusted, innovative, or award-winning require careful sourcing and neutral framing. Unsupported promotional claims are a common reason articles fail review.\",{\"children\":\"Avoid preparing a draft around marketing claims. Statements about being the best, leading, trusted, innovative, or award-winning require careful sourcing and neutral framing. Unsupported promotional claims are a common reason articles fail review.\"}]\n24:[\"$\",\"section\",\"policy-compliance\",{\"id\":\"policy-compliance\",\"className\":\"mb-10 scroll-mt-28\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-display text-2xl font-semibold text-navy md:text-3xl\",\"children\":\"Use a policy-compliant approach\"}],[\"$\",\"div\",null,{\"className\":\"mt-4 space-y-4 text-base leading-8 text-muted\",\"children\":[[\"$\",\"p\",\"Neutral point of view, verifiability, and reliable sourcing are core content policies. Conflict-of-interest and paid-contribution disclosure expectations are also important when someone connected to the business is involved in drafting or editing.\",{\"children\":\"Neutral point of view, verifiability, and reliable sourcing are core content policies. Conflict-of-interest and paid-contribution disclosure expectations are also important when someone connected to the business is involved in drafting or editing.\"}],[\"$\",\"p\",\"A responsible approach may include requesting feedback, improving sourcing, or using an appropriate drafting/review path based on the situation. The right path depends on the topic, available sources, and level of involvement. There is no shortcut that guarantees acceptance.\",{\"children\":\"A responsible approach may include requesting feedback, improving sourcing, or using an appropriate drafting/review path based on the situation. The right path depends on the topic, available sources, and level of involvement. There is no shortcut that guarantees acceptance.\"}]]}]]}]\n25:[\"$\",\"section\",\"after-publication\",{\"id\":\"after-publication\",\"className\":\"mb-10 scroll-mt-28\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-display text-2xl font-semibold text-navy md:text-3xl\",\"children\":\"Plan for maintenance, not just creation\"}],[\"$\",\"div\",null,{\"className\":\"mt-4 space-y-4 text-base leading-8 text-muted\",\"children\":[[\"$\",\"p\",\"If an article exists, it still requires accurate maintenance. Changes should be supported by reliable sources and written neutrally. Businesses should expect that independent editors can modify, challenge, merge, or remove content based on policy and sourcing.\",{\"children\":\"If an article exists, it still requires accurate maintenance. Changes should be supported by reliable sources and written neutrally. Businesses should expect that independent editors can modify, challenge, merge, or remove content based on policy and sourcing.\"}],[\"$\",\"p\",\"The long-term goal should be a factual, verifiable public record—not control over the page. Ethical Wikipedia consulting focuses on readiness, compliance, and accurate source-based editing guidance.\",{\"children\":\"The long-term goal should be a factual, verifiable public record—not control over the page. Ethical Wikipedia consulting focuses on readiness, compliance, and accurate source-based editing guidance.\"}]]}]]}]\n26:[\"$\",\"section\",null,{\"id\":\"faqs\",\"className\":\"mb-10 scroll-mt-28\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-display text-2xl font-semibold text-navy md:text-3xl\",\"children\":\"Frequently asked questions\"}],[\"$\",\"div\",null,{\"className\":\"mt-5\",\"children\":[\"$\",\"$L29\",null,{\"items\":[{\"q\":\"Can every business get on Wikipedia?\",\"a\":\"No. A business generally needs sufficient independent, reliable coverage to meet Wikipedia’s notability and verifiability expectations. Many legitimate businesses do not yet meet those standards.\"},{\"q\":\"How long does it take to get a business on Wikipedia?\",\"a\":\"There is no fixed timeline. Time depends on source availability, article readiness, the drafting/review path, and independent editorial decisions. Any promise of a guaranteed timeframe or outcome should be treated cautiously.\"},{\"q\":\"Can MIQ LLC guarantee a Wikipedia page for my business?\",\"a\":\"No. MIQ LLC does not guarantee Wikipedia publication, approval, ranking, or retention. We provide consulting, notability research, article preparation guidance, and editorial support focused on responsible process.\"}]}]}]]}]\n27:[\"$\",\"section\",null,{\"id\":\"references\",\"className\":\"mb-10 scroll-mt-28 rounded-3xl border border-border bg-surface p-6\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-display text-2xl font-semibold text-navy\",\"children\":\"References\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-sm leading-6 text-muted\",\"children\":\"External references are provided for general guidance. Wikipedia policies and community practices can change, so review the current source pages before making decisions.\"}],[\"$\",\"ul\",null,{\"className\":\"mt-4 space-y-2 text-sm\",\"children\":[[\"$\",\"li\",\"https://en.wikipedia.org/wiki/Wikipedia:Notability_(organizations_and_companies)\",{\"children\":[\"$\",\"a\",null,{\"href\":\"https://en.wikipedia.org/wiki/Wikipedia:Notability_(organizations_and_companies)\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-electric hover:underline\",\"children\":\"Wikipedia: Notability (organizations and companies)\"}]}],[\"$\",\"li\",\"https://en.wikipedia.org/wiki/Wikipedia:Reliable_sources\",{\"children\":[\"$\",\"a\",null,{\"href\":\"https://en.wikipedia.org/wiki/Wikipedia:Reliable_sources\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-electric hover:underline\",\"children\":\"Wikipedia: Reliable sources\"}]}],[\"$\",\"li\",\"https://en.wikipedia.org/wiki/Wikipedia:Neutral_point_of_view\",{\"children\":[\"$\",\"a\",null,{\"href\":\"https://en.wikipedia.org/wiki/Wikipedia:Neutral_point_of_view\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-electric hover:underline\",\"children\":\"Wikipedia: Neutral point of view\"}]}],[\"$\",\"li\",\"https://en.wikipedia.org/wiki/Wikipedia:Conflict_of_interest\",{\"children\":[\"$\",\"a\",null,{\"href\":\"https://en.wikipedia.org/wiki/Wikipedia:Conflict_of_interest\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-electric hover:underline\",\"children\":\"Wikipedia: Conflict of interest\"}]}],[\"$\",\"li\",\"https://en.wikipedia.org/wiki/Wikipedia:Your_first_article\",{\"children\":[\"$\",\"a\",null,{\"href\":\"https://en.wikipedia.org/wiki/Wikipedia:Your_first_article\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-electric hover:underline\",\"children\":\"Wikipedia: Your first article\"}]}]]}]]}]\n28:[\"$\",\"div\",null,{\"className\":\"rounded-3xl bg-navy p-7 text-white\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-lg font-semibold\",\"children\":\"Want to know whether your business is ready for Wikipedia?\"}],[\"$\",\"$L22\",null,{\"href\":\"/contact\",\"className\":\"mt-4 inline-flex items-center gap-1 rounded-full bg-white px-5 py-3 text-sm font-semibold text-navy\",\"children\":[\"Request a Business Notability Review\",\" \",[\"$\",\"$L2a\",null,{\"icon\":{\"name\":\"arrow-right\",\"size\":24,\"node\":[[\"path\",{\"d\":\"M5 12h14\",\"key\":\"1ays0h\"}],[\"path\",{\"d\":\"m12 5 7 7-7 7\",\"key\":\"xquz4c\"}]]},\"size\":16}]]}]]}]\n19:1695\na:\"$undefined\"\n6:\"$undefined\"\n17:\"$undefined\"\n10:\"$undefined\"\n"}}