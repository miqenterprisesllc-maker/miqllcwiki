{"type":"app","meta":{"status":200,"headers":{"link":"</_next/static/media/82450a180bcad83c-s.p.0p-wng2nn8o-p.woff2>; rel=preload; as=\"font\"; crossorigin=\"\"; type=\"font/woff2\", </_next/static/media/abc90e3a599e849c-s.p.2y2uoi4t910qy.woff2>; rel=preload; as=\"font\"; crossorigin=\"\"; type=\"font/woff2\"","x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/blog/layout,_N_T_/blog/[slug]/layout,_N_T_/blog/[slug]/page,_N_T_/blog/how-to-get-your-business-on-wikipedia"},"segmentPaths":["/_tree","/_full","/_index","/blog/$d$slug/__PAGE__"],"prefetchHints":{"hints":49152,"slots":{"children":{"hints":49216,"slots":{"children":{"hints":49248,"slots":{"children":{"hints":49312,"slots":null}}}}}}},"routeCache":{"key":"/route-cache/APP_PAGE/598124ea42a7fa20b1ca4e05fb72834de73e98d2ec5bfb5863d326020e1250db/$/blog/how-to-get-your-business-on-wikipedia","owner":{"kind":"APP_PAGE","sourceRoute":"/blog/[slug]/page"},"isFallback":false}},"html":"<!DOCTYPE html><html lang=\"en\" class=\"_1ltb7q_variable lOHCoq_variable h-full\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/1j231i_t18bfz.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/0uk63h0tuavo5.js\"/><script src=\"/_next/static/chunks/3mwm0pfu8c8me.js\" async=\"\"></script><script src=\"/_next/static/chunks/2xbu7vbjlke9r.js\" async=\"\"></script><script src=\"/_next/static/chunks/2fuxlcqleg9x-.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-077hmtqrhcoji.js\" async=\"\"></script><script src=\"/_next/static/chunks/3don6yfijp8pi.js\" async=\"\"></script><script src=\"/_next/static/chunks/0wj0noag-9_fs.js\" async=\"\"></script><script src=\"/_next/static/chunks/0hlscisrmz_ud.js\" async=\"\"></script><meta name=\"theme-color\" content=\"#0b1b33\"/><meta name=\"color-scheme\" content=\"light\"/><meta name=\"next-size-adjust\" content=\"\"/><title>How to Get Your Business on Wikipedia | MIQ LLC | MIQ LLC</title><meta name=\"description\" content=\"A realistic guide to getting a business represented on Wikipedia, including eligibility, source requirements, neutral writing, and responsible next steps.\"/><meta name=\"application-name\" content=\"MIQ LLC\"/><link rel=\"manifest\" href=\"/manifest.webmanifest\"/><meta name=\"keywords\" content=\"how to get your business on Wikipedia,business Wikipedia page,Wikipedia page creation,Wikipedia notability for companies,Wikipedia consulting\"/><meta name=\"referrer\" content=\"origin-when-cross-origin\"/><meta name=\"creator\" content=\"MIQ LLC\"/><meta name=\"publisher\" content=\"MIQ LLC\"/><meta name=\"robots\" content=\"index, follow\"/><meta name=\"googlebot\" content=\"index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1\"/><meta name=\"category\" content=\"technology\"/><link rel=\"canonical\" href=\"https://miqllcwiki.com/blog/how-to-get-your-business-on-wikipedia\"/><link rel=\"alternate\" hrefLang=\"en\" href=\"https://miqllcwiki.com/blog/how-to-get-your-business-on-wikipedia\"/><link rel=\"alternate\" hrefLang=\"x-default\" href=\"https://miqllcwiki.com/blog/how-to-get-your-business-on-wikipedia\"/><meta name=\"format-detection\" content=\"telephone=no, address=no, email=no\"/><meta property=\"og:title\" content=\"How to Get Your Business on Wikipedia | MIQ LLC\"/><meta property=\"og:description\" content=\"A realistic guide to getting a business represented on Wikipedia, including eligibility, source requirements, neutral writing, and responsible next steps.\"/><meta property=\"og:url\" content=\"https://miqllcwiki.com/blog/how-to-get-your-business-on-wikipedia\"/><meta property=\"og:site_name\" content=\"MIQ LLC\"/><meta property=\"og:locale\" content=\"en_US\"/><meta property=\"og:type\" content=\"article\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"How to Get Your Business on Wikipedia | MIQ LLC\"/><meta name=\"twitter:description\" content=\"A realistic guide to getting a business represented on Wikipedia, including eligibility, source requirements, neutral writing, and responsible next steps.\"/><link rel=\"shortcut icon\" href=\"/favicon.svg\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.117ezoe8m31dk.ico\" sizes=\"48x48\" type=\"image/x-icon\"/><link rel=\"icon\" href=\"/favicon.svg\"/><link rel=\"apple-touch-icon\" href=\"/favicon.svg\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"min-h-full flex flex-col bg-background text-foreground antialiased\"><div hidden=\"\"><!--$--><!--/$--></div><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":[\"Organization\",\"ProfessionalService\",\"LocalBusiness\"],\"@id\":\"https://miqllcwiki.com/#organization\",\"name\":\"MIQ LLC\",\"legalName\":\"MIQ Enterprises LLC\",\"alternateName\":[\"MIQ\",\"MIQ LLC\",\"MIQ Enterprises\",\"MIQ Enterprises LLC\",\"MIQ LLC Wiki\",\"miqllcwiki\",\"miqllcwiki.com\",\"MIQ digital services\",\"MIQ Wikipedia consulting\"],\"url\":\"https://miqllcwiki.com\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://miqllcwiki.com/favicon.svg\"},\"image\":\"https://miqllcwiki.com/opengraph-image\",\"description\":\"MIQ LLC (legal entity: MIQ Enterprises LLC) is an international digital services and technology solutions company delivering professional Wikipedia consulting, Wikipedia page creation guidance, Wikipedia editing and notability research, SEO, AEO, GEO, digital marketing, website development, branding, reputation management, and business technology solutions for clients in the United States and worldwide.\",\"slogan\":\"Your Vision. Our Digital Expertise.\",\"email\":\"miqenterprisesllc@gmail.com\",\"telephone\":\"+1 (914) 730-2443\",\"priceRange\":\"$$\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"154