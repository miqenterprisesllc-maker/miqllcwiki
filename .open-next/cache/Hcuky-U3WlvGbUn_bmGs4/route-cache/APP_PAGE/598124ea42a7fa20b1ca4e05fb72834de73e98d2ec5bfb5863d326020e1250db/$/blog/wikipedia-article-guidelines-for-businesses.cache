\",\"19\",{\"property\":\"og:locale\",\"content\":\"en_US\"}],[\"$\",\"meta\",\"20\",{\"property\":\"og:type\",\"content\":\"article\"}],[\"$\",\"meta\",\"21\",{\"name\":\"twitter:card\",\"content\":\"summary_large_image\"}],[\"$\",\"meta\",\"22\",{\"name\":\"twitter:title\",\"content\":\"Wikipedia Article Guidelines for Businesses | MIQ LLC\"}],[\"$\",\"meta\",\"23\",{\"name\":\"twitter:description\",\"content\":\"Key Wikipedia guidelines businesses should understand before creating or editing an article, including notability, neutrality, sourcing, and disclosure.\"}],[\"$\",\"link\",\"24\",{\"rel\":\"shortcut icon\",\"href\":\"/favicon.svg\"}],[\"$\",\"link\",\"25\",{\"rel\":\"icon\",\"href\":\"/favicon.ico?favicon.117ezoe8m31dk.ico\",\"sizes\":\"48x48\",\"type\":\"image/x-icon\"}],[\"$\",\"link\",\"26\",{\"rel\":\"icon\",\"href\":\"/favicon.svg\"}],[\"$\",\"link\",\"27\",{\"rel\":\"apple-touch-icon\",\"href\":\"/favicon.svg\"}],[\"$\",\"$L31\",\"28\",{}]]\n2f:[\"$\",\"section\",null,{\"className\":\"hero-grid text-white\",\"children\":[\"$\",\"div\",null,{\"className\":\"grid-lines\",\"children\":[\"$\",\"div\",null,{\"className\":\"container-tight py-20 md:py-24\",\"children\":[[\"$\",\"nav\",null,{\"aria-label\":\"Breadcrumb\",\"className\":\"mb-4 text-sm text-white/65\",\"children\":[\"$\",\"ol\",null,{\"className\":\"flex flex-wrap items-center gap-2\",\"children\":[[\"$\",\"li\",null,{\"children\":[\"$\",\"$L20\",null,{\"href\":\"/\",\"className\":\"hover:text-white\",\"children\":\"Home\"}]}],[\"$\",\"li\",null,{\"aria-hidden\":\"true\",\"children\":\"/\"}],[\"$\",\"li\",null,{\"children\":[\"$\",\"$L20\",null,{\"href\":\"/blog\",\"className\":\"hover:text-white\",\"children\":\"Insights\"}]}],[\"$\",\"li\",null,{\"aria-hidden\":\"true\",\"children\":\"/\"}],[\"$\",\"li\",null,{\"className\":\"text-white/85\",\"children\":\"Wikipedia Article Guidelines for Businesses\"}]]}]}],[\"$\",\"p\",null,{\"className\":\"mb-3 text-xs font-semibold uppercase tracking-[0.22em] text-electric\",\"children\":[\"$\",\"span\",null,{\"className\":\"text-sky-300\",\"children\":[\"Wikipedia\",\" Guide\"]}]}],[\"$\",\"h1\",null,{\"className\":\"font-display max-w-4xl text-4xl font-semibold md:text-5xl\",\"children\":\"Wikipedia Article Guidelines for Businesses\"}],[\"$\",\"p\",null,{\"className\":\"mt-5 max-w-3xl text-lg text-white/78\",\"children\":\"Business articles on Wikipedia must follow the same core standards as other topics: verifiable content, reliable independent sources, neutral tone, and compliance with conflict-of-interest expectations. Understanding these guidelines early helps avoid common mistakes.\"}],[\"$\",\"p\",null,{\"className\":\"mt-4 text-sm text-white/60\",\"children\":[\"Published \",\"2026-11-10\",\" · Updated \",\"2026-11-10\"]}]]}]}]}]\n30:[\"$\",\"section\",null,{\"id\":\"$undefined\",\"className\":\"section-pad \",\"children\":[\"$\",\"div\",null,{\"className\":\"container-tight grid gap-10 lg:grid-cols-[.28fr_.72fr]\",\"children\":[[\"$\",\"aside\",null,{\"className\":\"lg:sticky lg:top-28 lg:self-start\",\"children\":[\"$\",\"div\",null,{\"className\":\"rounded-3xl border border-border bg-surface p-5\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-display text-sm font-semibold uppercase tracking-[0.14em] text-electric\",\"children\":\"On this page\"}],[\"$\",\"ul\",null,{\"className\":\"mt-4 space-y-2 text-sm text-muted\",\"children\":[[[\"$\",\"li\",\"core-policies\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#core-policies\",\"className\":\"hover:text-navy\",\"children\":\"Start with core content policies\"}]}],[\"$\",\"li\",\"company-notability\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#company-notability\",\"className\":\"hover:text-navy\",\"children\":\"Understand company notability expectations\"}]}],[\"$\",\"li\",\"writing-standards\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#writing-standards\",\"className\":\"hover:text-navy\",\"children\":\"Write in an encyclopedic style\"}]}],[\"$\",\"li\",\"editing-participation\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#editing-participation\",\"className\":\"hover:text-navy\",\"children\":\"Handle company involvement carefully\"}]}]],[\"$\",\"li\",null,{\"children\":[\"$\",\"a\",null,{\"href\":\"#faqs\",\"className\":\"hover:text-navy\",\"children\":\"Frequently asked questions\"}]}],[\"$\",\"li\",null,{\"children\":[\"$\",\"a\",null,{\"href\":\"#references\",\"className\":\"hover:text-navy\",\"children\":\"References\"}]}]]}]]}]}],[\"$\",\"article\",null,{\"className\":\"max-w-3xl\",\"children\":[[[\"$\",\"section\",\"core-policies\",{\"id\":\"core-policies\",\"className\":\"mb-10 scroll-mt-28\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-display text-2xl font-semibold text-navy md:text-3xl\",\"children\":\"Start with core content policies\"}],[\"$\",\"div\",null,{\"className\":\"mt-4 space-y-4 text-base leading-8 text-muted\",\"children\":[[\"$\",\"p\",\"Wikipedia’s core content policies shape every business article. Verifiability means readers should be able to check important claims against reliable sources. Neutral point of view means the article should present information fairly, without promotional language or advocacy.\",{\"children\":\"Wikipedia’s core content policies shape every business article. Verifiability means readers should be able to check important claims against reliable sources. Neutral point of view means the article should present information fairly, without promotional language or advocacy.\"}],[\"$\",\"p\",\"No original research is also important. A business article should summarize what reliable published sources say, not introduce new claims, interpretations, or marketing narratives that lack independent support.\",{\"children\":\"No original research is also important. A business article should summarize what reliable published sources say, not introduce new claims, interpretations, or marketing narratives that lack independent support.\"}]]}]]}],[\"$\",\"section\",\"company-notability\",{\"id\":\"company-notability\",\"className\":\"mb-10 scroll-mt-28\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-display text-2xl font-semibold text-navy md:text-3xl\",\"children\":\"Understand company notability expectations\"}],[\"$\",\"div\",null,{\"className\":\"mt-4 space-y-4 text-base leading-8 text-muted\",\"children\":[[\"$\",\"p\",\"For organizations and companies, notability is commonly established through significant coverage in reliable, independent secondary sources. Routine database listings, press releases, self-published profiles, and paid content are usually not enough by themselves.\",{\"children\":\"For organizations and companies, notability is commonly established through significant coverage in reliable, independent secondary sources. Routine database listings, press releases, self-published profiles, and paid content are usually not enough by themselves.\"}],\"$L32\"]}]]}],\"$L33\",\"$L34\"],\"$L35\",\"$L36\",\"$L37\"]}]]}]}]\n38:I[28792,[\"$13\",\"$1f\"],\"FAQ\"]\n39:I[5014,[\"$13\",\"$1f\"],\"default\"]\n32:[\"$\",\"p\",\"Before drafting, businesses should assess whether coverage is substantial, independent, and focused on the company. Topic-specific notability guidance can help, but each case still depends on the quality and context of available sources.\",{\"children\":\"Before drafting, businesses should assess whether coverage is substantial, independent, and focused on the company. Topic-specific notability guidance can help, but each case still depends on the quality and context of available sources.\"}]\n33:[\"$\",\"section\",\"writing-standards\",{\"id\":\"writing-standards\",\"className\":\"mb-10 scroll-mt-28\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-display text-2xl font-semibold text-navy md:text-3xl\",\"children\":\"Write in an encyclopedic style\"}],[\"$\",\"div\",null,{\"className\":\"mt-4 space-y-4 text-base leading-8 text-muted\",\"children\":[[\"$\",\"p\",\"Business articles should use clear, factual language. Avoid slogans, superlatives, unattributed praise, and long lists of products or services unless they are supported by reliable sources and presented proportionately.\",{\"children\":\"Business articles should use clear, factual language. Avoid slogans, superlatives, unattributed praise, and long lists of products or services unless they are supported by reliable sources and presented proportionately.\"}],[\"$\",\"p\",\"Structure matters. A well-prepared draft usually includes only the most verifiable and relevant information, with citations placed near the claims they support. Content should reflect what independent sources emphasize, not internal marketing priorities.\",{\"children\":\"Structure matters. A well-prepared draft usually includes only the most verifiable and relevant information, with citations placed near the claims they support. Content should reflect what independent sources emphasize, not internal marketing priorities.\"}]]}]]}]\n34:[\"$\",\"section\",\"editing-participation\",{\"id\":\"editing-participation\",\"className\":\"mb-10 scroll-mt-28\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-display text-2xl font-semibold text-navy md:text-3xl\",\"children\":\"Handle company involvement carefully\"}],[\"$\",\"div\",null,{\"className\":\"mt-4 space-y-4 text-base leading-8 text-muted\",\"children\":[[\"$\",\"p\",\"Employees, founders, agencies, and consultants may have a conflict of interest when editing about a business they represent. Paid-contribution disclosure and transparent participation help reduce risk and maintain trust.\",{\"children\":\"Employees, founders, agencies, and consultants may have a conflict of interest when editing about a business they represent. Paid-contribution disclosure and transparent participation help reduce risk and maintain trust.\"}],[\"$\",\"p\",\"When involvement creates COI concerns, it may be better to suggest changes with sources, seek feedback, or use an appropriate review process rather than making promotional direct edits. Policy-aware guidance can help determine the safest path.\",{\"children\":\"When involvement creates COI concerns, it may be better to suggest changes with sources, seek feedback, or use an appropriate review process rather than making promotional direct edits. Policy-aware guidance can help determine the safest path.\"}]]}]]}]\n35:[\"$\",\"section\",null,{\"id\":\"faqs\",\"className\":\"mb-10 scroll-mt-28\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-display text-2xl font-semibold text-navy md:text-3xl\",\"children\":\"Frequently asked questions\"}],[\"$\",\"div\",null,{\"className\":\"mt-5\",\"children\":[\"$\",\"$L38\",null,{\"items\":[{\"q\":\"Can a business write its own Wikipedia article?\",\"a\":\"A business can gather sources and understand the process, but direct involvement can raise conflict-of-interest concerns. Neutrality, reliable sourcing, and transparent handling of paid or connected editing are important considerations.\"},{\"q\":\"What content should a business article include?\",\"a\":\"It should include only information supported by reliable independent sources, presented neutrally and proportionately. The exact content depends on what sources cover, not what the business wants to promote.\"},{\"q\":\"Do Wikipedia guidelines guarantee approval if followed?\",\"a\":\"No. Following guidelines improves quality and compliance, but independent Wikipedia editors make final decisions about content, inclusion, and retention.\"}]}]}]]}]\n36:[\"$\",\"section\",null,{\"id\":\"references\",\"className\":\"mb-10 scroll-mt-28 rounded-3xl border border-border bg-surface p-6\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-display text-2xl font-semibold text-navy\",\"children\":\"References\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-sm leading-6 text-muted\",\"children\":\"External references are provided for general guidance. Wikipedia policies and community practices can change, so review the current source pages before making decisions.\"}],[\"$\",\"ul\",null,{\"className\":\"mt-4 space-y-2 text-sm\",\"children\":[[\"$\",\"li\",\"https://en.wikipedia.org/wiki/Wikipedia:Notability_(organizations_and_companies)\",{\"children\":[\"$\",\"a\",null,{\"href\":\"https://en.wikipedia.org/wiki/Wikipedia:Notability_(organizations_and_companies)\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-electric hover:underline\",\"children\":\"Wikipedia: Notability (organizations and companies)\"}]}],[\"$\",\"li\",\"https://en.wikipedia.org/wiki/Wikipedia:Verifiability\",{\"children\":[\"$\",\"a\",null,{\"href\":\"https://en.wikipedia.org/wiki/Wikipedia:Verifiability\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-electric hover:underline\",\"children\":\"Wikipedia: Verifiability\"}]}],[\"$\",\"li\",\"https://en.wikipedia.org/wiki/Wikipedia:Neutral_point_of_view\",{\"children\":[\"$\",\"a\",null,{\"href\":\"https://en.wikipedia.org/wiki/Wikipedia:Neutral_point_of_view\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-electric hover:underline\",\"children\":\"Wikipedia: Neutral point of view\"}]}],[\"$\",\"li\",\"https://en.wikipedia.org/wiki/Wikipedia:No_original_research\",{\"children\":[\"$\",\"a\",null,{\"href\":\"https://en.wikipedia.org/wiki/Wikipedia:No_original_research\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-electric hover:underline\",\"children\":\"Wikipedia: No original research\"}]}],[\"$\",\"li\",\"https://en.wikipedia.org/wiki/Wikipedia:Conflict_of_interest\",{\"children\":[\"$\",\"a\",null,{\"href\":\"https://en.wikipedia.org/wiki/Wikipedia:Conflict_of_interest\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-electric hover:underline\",\"children\":\"Wikipedia: Conflict of interest\"}]}]]}]]}]\n37:[\"$\",\"div\",null,{\"className\":\"rounded-3xl bg-navy p-7 text-white\",\"children\":[[\"$\",