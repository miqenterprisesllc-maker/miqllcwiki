cle\\\",null,{\\\"className\\\":\\\"max-w-3xl\\\",\\\"children\\\":[[[\\\"$\\\",\\\"section\\\",\\\"community-process\\\",{\\\"id\\\":\\\"community-process\\\",\\\"className\\\":\\\"mb-10 scroll-mt-28\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"font-display text-2xl font-semibold text-navy md:text-3xl\\\",\\\"children\\\":\\\"Review is community-driven\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mt-4 space-y-4 text-base leading-8 text-muted\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",\\\"Wikipedia is edited by a volunteer community, and review can happen in different ways. Articles may be created, improved, tagged, discussed, revised, or nominated for deletion depending on their quality and sourcing. Drafts may also receive feedback through submission or review processes.\\\",{\\\"children\\\":\\\"Wikipedia is edited by a volunteer community, and review can happen in different ways. Articles may be created, improved, tagged, discussed, revised, or nominated for deletion depending on their quality and sourcing. Drafts may also receive feedback through submission or review processes.\\\"}],[\\\"$\\\",\\\"p\\\",\\\"Because many editors can participate, there is no single path that guarantees the same result for every topic. The quality of sources and the neutrality of writing are usually central to how an article is evaluated.\\\",{\\\"children\\\":\\\"Because many editors can participate, there is no single path that guarantees the same result for every topic. The quality of sources and the neutrality of writing are usually central to how an article is evaluated.\\\"}]]}]]}],[\\\"$\\\",\\\"section\\\",\\\"what-editors-check\\\",{\\\"id\\\":\\\"what-editors-check\\\",\\\"className\\\":\\\"mb-10 scroll-mt-28\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"font-display text-2xl font-semibold text-navy md:text-3xl\\\",\\\"children\\\":\\\"What editors commonly check\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mt-4 space-y-4 text-base leading-8 text-muted\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",\\\"Editors often assess whether the topic is notable, whether claims are verifiable, and whether sources are reliable and independent. They may also check tone for promotional language, evaluate whether the article has a conflict-of-interest appearance, and look for copyright or close paraphrasing issues.\\\",{\\\"children\\\":\\\"Editors often assess whether the topic is notable, whether claims are verifiable, and whether sources are reliable and independent. They may also check tone for promotional language, evaluate whether the article has a conflict-of-interest appearance, and look for copyright or close paraphrasing issues.\\\"}],\\\"$L32\\\"]}]]}],\\\"$L33\\\",\\\"$L34\\\"],\\\"$L35\\\",\\\"$L36\\\",\\\"$L37\\\"]}]]}]}]\\n\"])</script><script>self.__next_f.push([1,\"38:I[28792,[\\\"$13\\\",\\\"$1f\\\"],\\\"FAQ\\\"]\\n39:I[5014,[\\\"$13\\\",\\\"$1f\\\"],\\\"default\\\"]\\n32:[\\\"$\\\",\\\"p\\\",\\\"For business and biography topics, sourcing and neutrality receive particular attention. An article that is technically well-formatted but based on weak or non-independent sources may still be challenged.\\\",{\\\"children\\\":\\\"For business and biography topics, sourcing and neutrality receive particular attention. An article that is technically well-formatted but based on weak or non-independent sources may still be challenged.\\\"}]\\n\"])</script><script>self.__next_f.push([1,\"33:[\\\"$\\\",\\\"section\\\",\\\"possible-outcomes\\\",{\\\"id\\\":\\\"possible-outcomes\\\",\\\"className\\\":\\\"mb-10 scroll-mt-28\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"font-display text-2xl font-semibold text-navy md:text-3xl\\\",\\\"children\\\":\\\"Possible outcomes after review\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mt-4 space-y-4 text-base leading-8 text-muted\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",\\\"An article may be expanded, improved, merged, redirected, kept with cleanup tags, or deleted. Feedback can range from minor citation requests to concerns about notability or promotional content. Outcomes depend on evidence, policy application, and editorial discussion.\\\",{\\\"children\\\":\\\"An article may be expanded, improved, merged, redirected, kept with cleanup tags, or deleted. Feedback can range from minor citation requests to concerns about notability or promotional content. Outcomes depend on evidence, policy application, and editorial discussion.\\\"}],[\\\"$\\\",\\\"p\\\",\\\"If concerns are raised, improving sources and neutrality is often more productive than disputing the process with unsourced arguments. In some cases, the correct outcome may be to wait until stronger independent coverage exists.\\\",{\\\"children\\\":\\\"If concerns are raised, improving sources and neutrality is often more productive than disputing the process with unsourced arguments. In some cases, the correct outcome may be to wait until stronger independent coverage exists.\\\"}]]}]]}]\\n\"])</script><script>self.__next_f.push([1,\"34:[\\\"$\\\",\\\"section\\\",\\\"prepare-for-review\\\",{\\\"id\\\":\\\"prepare-for-review\\\",\\\"className\\\":\\\"mb-10 scroll-mt-28\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"font-display text-2xl font-semibold text-navy md:text-3xl\\\",\\\"children\\\":\\\"How to prepare before review\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mt-4 space-y-4 text-base leading-8 text-muted\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",\\\"Preparation should include a source inventory, claim-by-claim verification, neutral wording, and careful handling of any conflict of interest. Drafts should be concise and limited to what reliable independent sources support.\\\",{\\\"children\\\":\\\"Preparation should include a source inventory, claim-by-claim verification, neutral wording, and careful handling of any conflict of interest. Drafts should be concise and limited to what reliable independent sources support.\\\"}],[\\\"$\\\",\\\"p\\\",\\\"A policy-aware pre-submission review can identify issues early, but it cannot control how independent editors respond. The goal is to submit accurate, well-sourced material that can withstand scrutiny.\\\",{\\\"children\\\":\\\"A policy-aware pre-submission review can identify issues early, but it cannot control how independent editors respond. The goal is to submit accurate, well-sourced material that can withstand scrutiny.\\\"}]]}]]}]\\n35:[\\\"$\\\",\\\"section\\\",null,{\\\"id\\\":\\\"faqs\\\",\\\"className\\\":\\\"mb-10 scroll-mt-28\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"font-display text-2xl font-semibold text-navy md:text-3xl\\\",\\\"children\\\":\\\"Frequently asked questions\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mt-5\\\",\\\"children\\\":[\\\"$\\\",\\\"$L38\\\",null,{\\\"items\\\":[{\\\"q\\\":\\\"Is there an official Wikipedia approval team?\\\",\\\"a\\\":\\\"Wikipedia content is generally reviewed by community editors through various processes. There is no single approval path that guarantees publication for every article.\\\"},{\\\"q\\\":\\\"What makes editors keep an article?\\\",\\\"a\\\":\\\"Strong independent sourcing, clear notability, neutral writing, verifiable claims, and compliance with Wikipedia policies improve an article’s quality. However, no factor guarantees that an article will be kept.\\\"},{\\\"q\\\":\\\"Can an article be changed after it is published?\\\",\\\"a\\\":\\\"Yes. Wikipedia articles can be edited by others over time. Changes should be based on reliable sources and follow content policies.\\\"}]}]}]]}]\\n\"])</script><script>self.__next_f.push([1,\"36:[\\\"$\\\",\\\"section\\\",null,{\\\"id\\\":\\\"references\\\",\\\"className\\\":\\\"mb-10 scroll-mt-28 rounded-3xl border border-border bg-surface p-6\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"font