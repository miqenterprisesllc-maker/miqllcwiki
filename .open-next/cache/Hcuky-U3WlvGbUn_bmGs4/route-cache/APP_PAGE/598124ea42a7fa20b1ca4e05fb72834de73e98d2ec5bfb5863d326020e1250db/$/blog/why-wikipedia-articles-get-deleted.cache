les are deleted or nominated for deletion, including weak sourcing, promotional tone, and notability concerns.\"}],[\"$\",\"link\",\"24\",{\"rel\":\"shortcut icon\",\"href\":\"/favicon.svg\"}],[\"$\",\"link\",\"25\",{\"rel\":\"icon\",\"href\":\"/favicon.ico?favicon.117ezoe8m31dk.ico\",\"sizes\":\"48x48\",\"type\":\"image/x-icon\"}],[\"$\",\"link\",\"26\",{\"rel\":\"icon\",\"href\":\"/favicon.svg\"}],[\"$\",\"link\",\"27\",{\"rel\":\"apple-touch-icon\",\"href\":\"/favicon.svg\"}],[\"$\",\"$L1f\",\"28\",{}]]\n1a:false\n20:\"/_next/static/chunks/3don6yfijp8pi.js\"\n21:\"/_next/static/chunks/0hlscisrmz_ud.js\"\n22:I[22016,[\"$20\",\"$21\"],\"\"]\n1d:[\"$\",\"section\",null,{\"className\":\"hero-grid text-white\",\"children\":[\"$\",\"div\",null,{\"className\":\"grid-lines\",\"children\":[\"$\",\"div\",null,{\"className\":\"container-tight py-20 md:py-24\",\"children\":[[\"$\",\"nav\",null,{\"aria-label\":\"Breadcrumb\",\"className\":\"mb-4 text-sm text-white/65\",\"children\":[\"$\",\"ol\",null,{\"className\":\"flex flex-wrap items-center gap-2\",\"children\":[[\"$\",\"li\",null,{\"children\":[\"$\",\"$L22\",null,{\"href\":\"/\",\"className\":\"hover:text-white\",\"children\":\"Home\"}]}],[\"$\",\"li\",null,{\"aria-hidden\":\"true\",\"children\":\"/\"}],[\"$\",\"li\",null,{\"children\":[\"$\",\"$L22\",null,{\"href\":\"/blog\",\"className\":\"hover:text-white\",\"children\":\"Insights\"}]}],[\"$\",\"li\",null,{\"aria-hidden\":\"true\",\"children\":\"/\"}],[\"$\",\"li\",null,{\"className\":\"text-white/85\",\"children\":\"Why Wikipedia Articles Get Deleted\"}]]}]}],[\"$\",\"p\",null,{\"className\":\"mb-3 text-xs font-semibold uppercase tracking-[0.22em] text-electric\",\"children\":[\"$\",\"span\",null,{\"className\":\"text-sky-300\",\"children\":[\"Wikipedia\",\" Guide\"]}]}],[\"$\",\"h1\",null,{\"className\":\"font-display max-w-4xl text-4xl font-semibold md:text-5xl\",\"children\":\"Why Wikipedia Articles Get Deleted\"}],[\"$\",\"p\",null,{\"className\":\"mt-5 max-w-3xl text-lg text-white/78\",\"children\":\"Articles are commonly deleted when they lack reliable independent sourcing, read like advertisements, fail notability expectations, or do not comply with Wikipedia’s content policies. Understanding these risks early can prevent avoidable problems.\"}],[\"$\",\"p\",null,{\"className\":\"mt-4 text-sm text-white/60\",\"children\":[\"Published \",\"2026-11-10\",\" · Updated \",\"2026-11-10\"]}]]}]}]}]\n1e:[\"$\",\"section\",null,{\"className\":\"section-pad \",\"children\":[\"$\",\"div\",null,{\"className\":\"container-tight grid gap-10 lg:grid-cols-[.28fr_.72fr]\",\"children\":[[\"$\",\"aside\",null,{\"className\":\"lg:sticky lg:top-28 lg:self-start\",\"children\":[\"$\",\"div\",null,{\"className\":\"rounded-3xl border border-border bg-surface p-5\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-display text-sm font-semibold uppercase tracking-[0.14em] text-electric\",\"children\":\"On this page\"}],[\"$\",\"ul\",null,{\"className\":\"mt-4 space-y-2 text-sm text-muted\",\"children\":[[[\"$\",\"li\",\"notability-sourcing\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#notability-sourcing\",\"className\":\"hover:text-navy\",\"children\":\"Insufficient notability or sourcing\"}]}],[\"$\",\"li\",\"promotional-tone\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#promotional-tone\",\"className\":\"hover:text-navy\",\"children\":\"Promotional or advocacy tone\"}]}],[\"$\",\"li\",\"policy-issues\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#policy-issues\",\"className\":\"hover:text-navy\",\"children\":\"Content and process issues\"}]}],[\"$\",\"li\",\"prevention\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#prevention\",\"className\":\"hover:text-navy\",\"children\":\"How to reduce deletion risk\"}]}]],[\"$\",\"li\",null,{\"children\":[\"$\",\"a\",null,{\"href\":\"#faqs\",\"className\":\"hover:text-navy\",\"children\":\"Frequently asked questions\"}]}],[\"$\",\"li\",null,{\"children\":[\"$\",\"a\",null,{\"href\":\"#references\",\"className\":\"hover:text-navy\",\"children\":\"References\"}]}]]}]]}]}],[\"$\",\"article\",null,{\"className\":\"max-w-3xl\",\"children\":[[[\"$\",\"section\",\"notability-sourcing\",{\"id\":\"notability-sourcing\",\"className\":\"mb-10 scroll-mt-28\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-display text-2xl font-semibold text-navy md:text-3xl\",\"children\":\"Insufficient notability or sourcing\"}],[\"$\",\"div\",null,{\"className\":\"mt-4 space-y-4 text-base leading-8 text-muted\",\"children\":[[\"$\",\"p\",\"A frequent reason for deletion is that the topic does not appear to meet notability expectations, or the article does not provide enough reliable independent sources to support its claims. Even when a company or person is real, Wikipedia still requires verifiable published coverage from appropriate sources.\",{\"children\":\"A frequent reason for deletion is that the topic does not appear to meet notability expectations, or the article does not provide enough reliable independent sources to support its claims. Even when a company or person is real, Wikipedia still requires verifiable published coverage from appropriate sources.\"}],[\"$\",\"p\",\"Editors may challenge articles that rely heavily on primary sources, press releases, or self-published material. If key claims cannot be verified, the article may be nominated for deletion or substantially revised.\",{\"children\":\"Editors may challenge articles that rely heavily on primary sources, press releases, or self-published material. If key claims cannot be verified, the article may be nominated for deletion or substantially revised.\"}]]}]]}],[\"$\",\"section\",\"promotional-tone\",{\"id\":\"promotional-tone\",\"className\":\"mb-10 scroll-mt-28\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-display text-2xl font-semibold text-navy md:text-3xl\",\"children\":\"Promotional or advocacy tone\"}],[\"$\",\"div\",null,{\"className\":\"mt-4 space-y-4 text-base leading-8 text-muted\",\"children\":[[\"$\",\"p\",\"Wikipedia is not a place for marketing copy. Articles written with persuasive language, slogans, unsupported superlatives, or excessive focus on products and services may be flagged. Neutral wording and balanced coverage are essential.\",{\"children\":\"Wikipedia is not a place for marketing copy. Articles written with persuasive language, slogans, unsupported superlatives, or excessive focus on products and services may be flagged. Neutral wording and balanced coverage are essential.\"}],[\"$\",\"p\",\"Conflict-of-interest editing can increase this risk. When an article appears to be written by or for the subject, editors may scrutinize tone, sourcing, and disclosure more closely.\",{\"children\":\"Conflict-of-interest editing can increase this risk. When an article appears to be written by or for the subject, editors may scrutinize tone, sourcing, and disclosure more closely.\"}]]}]]}],\"$L23\",\"$L24\"],\"$L25\",\"$L26\",\"$L27\"]}]]}]}]\n28:I[28792,[\"$20\",\"$21\"],\"FAQ\"]\n29:I[5014,[\"$20\",\"$21\"],\"default\"]\n23:[\"$\",\"section\",\"policy-issues\",{\"id\":\"policy-issues\",\"className\":\"mb-10 scroll-mt-28\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-display text-2xl font-semibold text-navy md:text-3xl\",\"children\":\"Content and process issues\"}],[\"$\",\"div\",null,{\"className\":\"mt-4 space-y-4 text-base leading-8 text-muted\",\"children\":[[\"$\",\"p\",\"Deletion can also result from copyright problems, lack of verifiability, unreliable sourcing, or articles created without following expected community processes. For some drafts, using a more appropriate review path can reduce avoidable friction.\",{\"children\":\"Deletion can also result from copyright problems, lack of verifiability, unreliable sourcing, or articles created without following expected community processes. For some drafts, using a more appropriate review path can reduce avoidable friction.\"}],[\"$\",\"p\",\"If an article is challenged, the best response is usually to improve sourcing and neutrality where possible—not to argue from promotional material. In some cases, the available evidence may simply be insufficient at that time.\",{\"children\":\"If an article is challenged, the best response is usually to improve sourcing and neutrality where possible—not to argue from promotional material. In some cases, the available evidence may simply be insufficient at that time.\"}]]}]]}]\n24:[\"$\",\"section\",\"prevention\",{\"id\":\"prevention\",\"className\":\"mb-10 scroll-mt-28\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-display text-2xl font-semibold text-navy md:text-3xl\",\"children\":\"How to reduce deletion risk\"}],[\"$\",\"div\",null,{\"className\":\"mt-4 space-y-4 text-base leading-8 text-muted\",\"children\":[[\"$\",\"p\",\"Risk reduction starts before writing: assess notability, collect independent sources, map claims to citations, and plan a neutral structure. Drafting should follow what sources support, not what the subject wants to emphasize.\",{\"children\":\"Risk reduction starts before writing: assess notability, collect independent sources, map claims to citations, and plan a neutral structure. Drafting should follow what sources support, not what the subject wants to emphasize.\"}],[\"$\",\"p\",\"A careful process does not eliminate risk. Wikipedia’s editorial community makes independent decisions, and outcomes can change over time as sources and policies are evaluated. Ethical guidance should focus on compliance and accuracy rather than guaranteed retention.\",{\"children\":\"A careful process does not eliminate risk. Wikipedia’s editorial community makes independent decisions, and outcomes can change over time as sources and policies are evaluated. Ethical guidance should focus on compliance and accuracy rather than guaranteed retention.\"}]]}]]}]\n25:[\"$\",\"section\",null,{\"id\":\"faqs\",\"className\":\"mb-10 scroll-mt-28\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-display text-2xl font-semibold text-navy md:text-3xl\",\"children\":\"Frequently asked questions\"}],[\"$\",\"div\",null,{\"className\":\"mt-5\",\"children\":[\"$\",\"$L28\",null,{\"items\":[{\"q\":\"Can a deleted Wikipedia article be restored?\",\"a\":\"Sometimes content can be improved and resubmitted through an appropriate process, but restoration depends on the reason for deletion and whether reliable independent sources support the topic. There is no guarantee of restoration.\"},{\"q\":\"Does paid editing cause deletion?\",\"a\":\"Paid editing alone is not the only issue, but undisclosed paid contributions, promotional writing, or weak sourcing can increase scrutiny and risk. Transparency and policy compliance are important.\"},{\"q\":\"How can I prevent deletion before publishing?\",\"a\":\"Start with a notability and source review, use independent reliable sources, write neutrally, and avoid unsupported claims. A policy-aware review can help identify risks before submission.\"}]}]}]]}]\n26:[\"$\",\"section\",null,{\"id\":\"references\",\"className\":\"mb-10 scroll-mt-28 rounded-3xl border border-border bg-surface p-6\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-display text-2xl font-semibold text-navy\",\"children\":\"References\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-sm leading-6 text-muted\",\"children\":\"External references are provided for general guidance. Wikipedia policies and community practices can change, so review the current source pages before making decisions.\"}],[\"$\",\"ul\",null,{\"className\":\"mt-4 space-y-2 text-sm\",\"children\":[[\"$\",\"li\",\"https://en.wikipedia.org/wiki/Wikipedia:Deletion_policy\",{\"children\":[\"$\",\"a\",null,{\"href\":\"https://en.wikipedia.org/wiki/Wikipedia:Deletion_policy\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-electric hover:underline\",\"children\":\"Wikipedia: Deletion policy\"}]}],[\"$\",\"li\",\"https://en.wikipedia.org/wiki/Wikipedia:Notability\",{\"children\":[\"$\",\"a\",null,{\"href\":\"https://en.wikipedia.org/wiki/Wikipedia:Notability\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-electric hover:underline\",\"children\":\"Wikipedia: Notability\"}]}],[\"$\",\"li\",\"https://en.wikipedia.org/wiki/Wikipedia:Neutral_point_of_view\",{\"children\":[\"$\",\"a\",null,{\"href\":\"https://en.wikipedia.org/wiki/Wikipedia:Neutral_point_of_view\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-electric hover:underline\",\"children\":\"Wikipedia: Neutral point of view\"}]}],[\"$\",\"li\",\"https://en.wikipedia.org/wiki/Wikipedia:Conflict_of_interest\",{\"children\":[\"$\",\"a\",null,{\"href\":\"https://en.wikipedia.org/wiki/Wikipedia:Conflict_of_interest\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-electric hover:underline\",\"children\":\"Wikipedia: Conflict of interest\"}]}]]}]]}]\n27:[\"$\",\"div\",null,{\"className\":\"rounded-3xl bg-navy p-7 text-white\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-lg font-semibold\",\"children\":\"Concerned about sourcing or deletion risk?\"}],[\"$\",\"$L22\",null,{\"href\":\"/services/wikipedia-services\",\"className\":\"mt-4 inline-flex items-center gap-1 rounded-full bg-white px-5 py-3 text-sm font-semibold text-navy\",\"children\":[\"Get Wikipedia Editorial Guidance\",\" \",[\"$\",\"$L29\",null,{\"icon\":{\"name\":\"arrow-right\",\"size\":24,\"node\":[[\"path\",{\"d\":\"M5 12h14\",\"key\":\"1ays0h\"}],[\"path\",{\"d\":\"m12 5 7 7-7 7\",\"key\":\"xquz4c\"}]]},\"size\":16}]]}]]}]\n19:1695\na:\"$undefined\"\n6:\"$undefined\"\n17:\"$undefined\"\n10:\"$undefined\"\n"}}