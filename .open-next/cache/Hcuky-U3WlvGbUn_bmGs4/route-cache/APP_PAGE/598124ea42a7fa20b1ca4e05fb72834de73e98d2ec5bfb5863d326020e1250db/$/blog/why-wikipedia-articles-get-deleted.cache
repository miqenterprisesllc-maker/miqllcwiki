{"type":"app","meta":{"status":200,"headers":{"link":"</_next/static/media/82450a180bcad83c-s.p.0p-wng2nn8o-p.woff2>; rel=preload; as=\"font\"; crossorigin=\"\"; type=\"font/woff2\", </_next/static/media/abc90e3a599e849c-s.p.2y2uoi4t910qy.woff2>; rel=preload; as=\"font\"; crossorigin=\"\"; type=\"font/woff2\"","x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/blog/layout,_N_T_/blog/[slug]/layout,_N_T_/blog/[slug]/page,_N_T_/blog/why-wikipedia-articles-get-deleted"},"segmentPaths":["/_tree","/_full","/_index","/blog/$d$slug/__PAGE__"],"prefetchHints":{"hints":49152,"slots":{"children":{"hints":49216,"slots":{"children":{"hints":49248,"slots":{"children":{"hints":49312,"slots":null}}}}}}},"routeCache":{"key":"/route-cache/APP_PAGE/598124ea42a7fa20b1ca4e05fb72834de73e98d2ec5bfb5863d326020e1250db/$/blog/why-wikipedia-articles-get-deleted","owner":{"kind":"APP_PAGE","sourceRoute":"/blog/[slug]/page"},"isFallback":false}},"html":"<!DOCTYPE html><html lang=\"en\" class=\"_1ltb7q_variable lOHCoq_variable h-full\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/1j231i_t18bfz.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/0uk63h0tuavo5.js\"/><script src=\"/_next/static/chunks/3mwm0pfu8c8me.js\" async=\"\"></script><script src=\"/_next/static/chunks/2xbu7vbjlke9r.js\" async=\"\"></script><script src=\"/_next/static/chunks/2fuxlcqleg9x-.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-077hmtqrhcoji.js\" async=\"\"></script><script src=\"/_next/static/chunks/3don6yfijp8pi.js\" async=\"\"></script><script src=\"/_next/static/chunks/0wj0noag-9_fs.js\" async=\"\"></script><script src=\"/_next/static/chunks/0hlscisrmz_ud.js\" async=\"\"></script><meta name=\"theme-color\" content=\"#0b1b33\"/><meta name=\"color-scheme\" content=\"light\"/><meta name=\"next-size-adjust\" content=\"\"/><title>Why Wikipedia Articles Get Deleted | MIQ LLC | MIQ LLC</title><meta name=\"description\" content=\"Understand common reasons Wikipedia articles are deleted or nominated for deletion, including weak sourcing, promotional tone, and notability concerns.\"/><meta name=\"application-name\" content=\"MIQ LLC\"/><link rel=\"manifest\" href=\"/manifest.webmanifest\"/><meta name=\"keywords\" content=\"why Wikipedia articles get deleted,Wikipedia deletion,Wikipedia notability,Wikipedia reliable sources,Wikipedia article guidelines\"/><meta name=\"referrer\" content=\"origin-when-cross-origin\"/><meta name=\"creator\" content=\"MIQ LLC\"/><meta name=\"publisher\" content=\"MIQ LLC\"/><meta name=\"robots\" content=\"index, follow\"/><meta name=\"googlebot\" content=\"index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1\"/><meta name=\"category\" content=\"technology\"/><link rel=\"canonical\" href=\"https://miqllcwiki.com/blog/why-wikipedia-articles-get-deleted\"/><link rel=\"alternate\" hrefLang=\"en\" href=\"https://miqllcwiki.com/blog/why-wikipedia-articles-get-deleted\"/><link rel=\"alternate\" hrefLang=\"x-default\" href=\"https://miqllcwiki.com/blog/why-wikipedia-articles-get-deleted\"/><meta name=\"format-detection\" content=\"telephone=no, address=no, email=no\"/><meta property=\"og:title\" content=\"Why Wikipedia Articles Get Deleted | MIQ LLC\"/><meta property=\"og:description\" content=\"Understand common reasons Wikipedia articles are deleted or nominated for deletion, including weak sourcing, promotional tone, and notability concerns.\"/><meta property=\"og:url\" content=\"https://miqllcwiki.com/blog/why-wikipedia-articles-get-deleted\"/><meta property=\"og:site_name\" content=\"MIQ LLC\"/><meta property=\"og:locale\" content=\"en_US\"/><meta property=\"og:type\" content=\"article\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"Why Wikiped